<% content_for :title, "beckit: a journal for noticing thinking traps" %>
<% content_for :bare_layout, "true" %>
<% content_for :head do %>
  <meta name="description" content="A private journal for spotting thinking traps, like catastrophizing or mind reading, and weighing them against the evidence. Not therapy.">
<% end %>
<% content_for :footer_note do %>
  <p class="-mt-6 pb-10 text-base/6 text-pretty text-stone-500 sm:text-sm/6 dark:text-stone-400">beckit is a self-help journaling tool. It does not provide therapy, diagnosis or medical advice.</p>
<% end %>

<div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[40rem] bg-linear-to-b from-teal-50/40 via-teal-50/30 to-transparent dark:from-teal-950/30 dark:via-transparent"></div>

