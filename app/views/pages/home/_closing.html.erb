<section aria-labelledby="closing_heading" class="mx-auto max-w-7xl px-4 pb-24 sm:px-6 lg:px-8 lg:pb-32">
  <div class="panel-teal flex flex-col items-start gap-8 rounded-3xl px-6 py-12 sm:px-10 lg:flex-row lg:items-end lg:justify-between lg:px-14 lg:py-16">
    <div>
      <h2 id="closing_heading" class="font-display text-4xl font-medium tracking-tight text-balance text-stone-900 sm:text-5xl dark:text-white">Start when you're ready.</h2>
      <p class="mt-4 max-w-[48ch] text-lg/8 text-pretty text-stone-600 dark:text-stone-300">Your first entry can be a single sentence about one moment from today.</p>
    </div>
    <div class="flex flex-wrap items-center gap-4">
      <%= link_to "Start your journal", new_registration_path, class: "btn-lg btn-primary" %>
      <p class="text-base/6 text-stone-600 sm:text-sm/6 dark:text-stone-300">Already have an account? <%= link_to "Sign in", new_session_path, class: "font-medium text-teal-700 hover:text-teal-600 dark:text-teal-400 dark:hover:text-teal-300" %></p>
    </div>
  </div>
</section>
