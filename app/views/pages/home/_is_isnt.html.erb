<section aria-labelledby="is_isnt_heading" class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-24">
  <h2 id="is_isnt_heading" class="max-w-[24ch] font-display text-3xl font-medium tracking-tight text-balance text-stone-900 sm:text-4xl dark:text-white">What beckit is, and what it isn't</h2>

  <div class="mt-12 grid gap-10 md:grid-cols-2 md:gap-16">
    <div class="border-t border-stone-950/10 pt-6 dark:border-white/15">
      <h3 class="text-base/6 font-semibold text-stone-900 dark:text-white">It is</h3>
      <ul role="list" class="mt-4 flex flex-col gap-3 text-base/7 text-stone-700 dark:text-stone-300">
        <% [ "A private journal. Only your account can see your entries.", "A structured way to write down a hard moment.", "A way to notice which patterns come up over time." ].each do |item| %>
          <li class="flex gap-3"><%= icon :check, "mt-1.5 text-teal-700 dark:text-teal-400" %><span><%= item %></span></li>
        <% end %>
      </ul>
    </div>
    <div class="border-t border-stone-950/10 pt-6 dark:border-white/15">
      <h3 class="text-base/6 font-semibold text-stone-900 dark:text-white">It isn't</h3>
      <ul role="list" class="mt-4 flex flex-col gap-3 text-base/7 text-stone-700 dark:text-stone-300">
        <% [ "Therapy, or a substitute for it.", "A diagnosis of any kind.", "Medical or mental health advice.", "A replacement for talking to a professional." ].each do |item| %>
          <li class="flex gap-3"><%= icon :x_mark, "mt-1.5 text-stone-400 dark:text-stone-500" %><span><%= item %></span></li>
        <% end %>
      </ul>
    </div>
  </div>
</section>
