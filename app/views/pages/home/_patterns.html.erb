<%# locals: (insights:) %>
<%# Two of the real Insights panels on sample data; the full set lives in the app. %>
<section aria-labelledby="patterns_heading" class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-24">
  <h2 id="patterns_heading" class="font-display text-3xl font-medium tracking-tight text-balance text-stone-900 sm:text-4xl dark:text-white">Learn your own patterns</h2>
  <p class="mt-4 max-w-[60ch] text-lg/8 text-pretty text-stone-600 dark:text-stone-400">After a few weeks, beckit shows which traps come up most, and when, where and with whom. It describes your entries. It doesn't interpret them.</p>

  <% if insights.distortion %>
    <figure class="mt-12">
      <div class="panel grid overflow-hidden lg:grid-cols-12" data-controller="tooltip" data-action="pointerover->tooltip#show pointerout->tooltip#hide focusin->tooltip#show focusout->tooltip#hide scroll@window->tooltip#dismiss">
        <div class="min-w-0 bg-teal-50/70 p-6 sm:p-10 lg:col-span-7 dark:bg-teal-400/[0.07]">
          <p class="font-display text-3xl font-medium tracking-tight text-stone-900 dark:text-white"><%= insights.distortion.title %></p>
          <p class="mt-2 max-w-[52ch] text-base/7 text-pretty text-stone-600 dark:text-stone-400"><%= insights.distortion.description %></p>
          <div class="mt-8"><%= render "insights/standouts", insights: %></div>
        </div>
        <div class="min-w-0 border-t border-stone-950/5 bg-white p-6 sm:p-10 lg:col-span-5 lg:border-t-0 lg:border-l dark:border-white/10 dark:bg-stone-900"><%= render "insights/weekly", insights: %></div>
        <%= render "insights/tooltip" %>
      </div>
      <figcaption class="mt-3 text-base/6 text-stone-500 sm:text-sm/6 dark:text-stone-400">Example data. Your insights come from your own entries.</figcaption>
    </figure>
  <% end %>
</section>
