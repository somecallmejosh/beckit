<%# locals: (insights:) %>
<% cell = "min-w-0 rounded-3xl bg-white p-6 ring-1 ring-stone-950/5 sm:p-8 dark:bg-stone-900 dark:ring-white/10" %>
<section aria-labelledby="patterns_heading" class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8 lg:py-32">
  <h2 id="patterns_heading" class="font-display text-3xl font-medium tracking-tight text-balance text-stone-900 sm:text-4xl dark:text-white">See your own patterns</h2>
  <p class="mt-4 max-w-[60ch] text-lg/8 text-pretty text-stone-600 dark:text-stone-400">Over time, beckit shows which traps come up most, and when, where and with whom. It describes your entries. It doesn't interpret them.</p>

  <% if insights.distortion %>
    <div class="mt-12 grid gap-4 lg:grid-cols-12 lg:gap-6" data-controller="tooltip" data-action="pointerover->tooltip#show pointerout->tooltip#hide scroll@window->tooltip#dismiss">
      <div class="min-w-0 rounded-3xl bg-teal-50/70 p-6 ring-1 ring-teal-700/10 sm:p-8 lg:col-span-7 dark:bg-teal-400/[0.07] dark:ring-teal-400/20">
        <p class="font-display text-3xl font-medium tracking-tight text-stone-900 dark:text-white"><%= insights.distortion.title %></p>
        <p class="mt-2 max-w-[52ch] text-base/7 text-pretty text-stone-600 dark:text-stone-400"><%= insights.distortion.description %></p>
        <div class="mt-8"><%= render "insights/standouts", insights: %></div>
      </div>
      <div class="<%= cell %> lg:col-span-5"><%= render "insights/weekly", insights: %></div>
      <div class="<%= cell %> lg:col-span-12"><%= render "insights/heatmap", insights: %></div>
      <div class="<%= cell %> lg:col-span-6"><%= render "insights/ranked_groups", insights:, column: :location, title: "Where", noun: "place" %></div>
      <div class="<%= cell %> lg:col-span-6"><%= render "insights/pairs", insights: %></div>
      <%= render "insights/tooltip" %>
    </div>
    <p class="mt-4 text-base/6 text-stone-500 sm:text-sm/6 dark:text-stone-400">Example data. Your insights come from your own entries.</p>
  <% end %>
</section>
