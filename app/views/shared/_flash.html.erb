<% if notice.present? && flash[:undo_situation_id] %>
  <div id="notice" role="status" class="flex flex-wrap items-center justify-between gap-3 rounded-2xl panel-teal px-4 py-3 text-base/6 text-pretty text-teal-900 sm:text-sm/6 dark:text-teal-200">
    <p><%= notice %></p>
    <%= button_to "Undo", situation_restoration_path(flash[:undo_situation_id]), class: "btn-sm btn-secondary" %>
  </div>
<% elsif notice.present? %>
  <p id="notice" role="status" class="rounded-2xl panel-teal px-4 py-3 text-base/6 text-pretty text-teal-900 sm:text-sm/6 dark:text-teal-200"><%= notice %></p>
<% end %>
<% if alert.present? %>
  <p id="alert" role="alert" class="rounded-2xl bg-red-50 px-4 py-3 text-base/6 text-pretty text-red-800 ring-1 ring-red-700/10 sm:text-sm/6 dark:bg-red-500/10 dark:text-red-300 dark:ring-red-400/20"><%= alert %></p>
<% end %>
