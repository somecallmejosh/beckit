<%# locals: (form:, label: "Password", confirm_label: "Confirm password", autofocus: false, record: nil) %>
<%# Model forms get inline errors from field_error_proc. URL-only forms (password reset, Settings) pass the user as
    record, so their errors show under the field the same way. %>
<% inline_error = ->(attribute) { record&.errors&.full_messages_for(attribute)&.to_sentence.presence } %>
<% password_error, confirmation_error = inline_error.(:password), inline_error.(:password_confirmation) %>
<div class="flex flex-col gap-2">
  <div>
    <%= form.label :password, label, class: "field-label" %>
    <p id="password_hint" class="field-hint">At least <%= User::PASSWORD_MIN_LENGTH %> characters.</p>
  </div>
  <%= form.password_field :password, required: true, autofocus:, autocomplete: "new-password", minlength: User::PASSWORD_MIN_LENGTH, maxlength: 72, class: "field",
        aria: { describedby: [ "password_hint", ("password_error" if password_error) ].compact.join(" "), invalid: (true if password_error) } %>
  <% if password_error %>
    <p id="password_error" class="field-error"><%= password_error %></p>
  <% end %>
</div>

<div class="flex flex-col gap-2">
  <%= form.label :password_confirmation, confirm_label, class: "field-label" %>
  <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", minlength: User::PASSWORD_MIN_LENGTH, maxlength: 72, class: "field",
        aria: { describedby: ("password_confirmation_error" if confirmation_error), invalid: (true if confirmation_error) } %>
  <% if confirmation_error %>
    <p id="password_confirmation_error" class="field-error"><%= confirmation_error %></p>
  <% end %>
</div>
