<%# locals: (form:, label: "Password", confirm_label: "Confirm password", autofocus: false) %>
<div class="flex flex-col gap-2">
  <div>
    <%= form.label :password, label, class: "field-label" %>
    <p id="password_hint" class="field-hint">At least <%= User::PASSWORD_MIN_LENGTH %> characters.</p>
  </div>
  <%= form.password_field :password, required: true, autofocus:, autocomplete: "new-password", minlength: User::PASSWORD_MIN_LENGTH, maxlength: 72, class: "field", aria: { describedby: "password_hint" } %>
</div>

<div class="flex flex-col gap-2">
  <%= form.label :password_confirmation, confirm_label, class: "field-label" %>
  <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", minlength: User::PASSWORD_MIN_LENGTH, maxlength: 72, class: "field" %>
</div>
