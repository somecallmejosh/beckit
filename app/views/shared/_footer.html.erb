<%# locals: (user:) %>
<% heading_class = "text-base/6 font-semibold text-stone-900 sm:text-sm/6 dark:text-white" %>
<% link_class = "text-base/6 text-stone-600 hover:text-stone-900 sm:text-sm/6 dark:text-stone-400 dark:hover:text-white hover:underline" %>
<footer class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
  <%= render "shared/be_kind" %>

  <div class="grid gap-12 border-t border-stone-950/5 py-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] lg:gap-16 dark:border-white/10">
    <div class="flex flex-col items-start gap-6">
      <a href="/" aria-label="beckit home" class="hover:opacity-75"><%= logo_tag %></a>
      <p class="max-w-[40ch] text-base/7 text-pretty text-stone-600 dark:text-stone-400">A private journal for noticing thinking traps and weighing them against the evidence.</p>

      <section aria-labelledby="crisis_heading" class="panel-teal w-full max-w-md rounded-2xl p-5">
        <h2 id="crisis_heading" class="<%= heading_class %>">Need to talk to someone now?</h2>
        <%= render "shared/crisis_line", user: user %>
        <% if user && !user.crisis_contact_name %>
          <%= link_to "Add your own crisis contact", edit_settings_path(anchor: "support"), class: "mt-3 inline-block text-base/6 font-medium text-teal-700 hover:text-teal-600 sm:text-sm/6 dark:text-teal-400 dark:hover:text-teal-300" %>
        <% end %>
      </section>
    </div>

    <div class="grid lg:grid-cols-3 gap-8 <%= "sm:grid-cols-3" if user %>">
      <% if user %>
        <nav aria-labelledby="footer_journal_heading">
          <h2 id="footer_journal_heading" class="<%= heading_class %>">Your journal</h2>
          <ul class="mt-4 flex flex-col gap-3">
            <li><%= link_to "New entry", new_situation_path, class: link_class %></li>
            <li><%= link_to "All entries", situations_path, class: link_class %></li>
            <li><%= link_to "Insights", insights_path, class: link_class %></li>
          </ul>
        </nav>
      <% else %>
        <nav aria-labelledby="footer_journal_heading">
          <h2 id="footer_journal_heading" class="<%= heading_class %>">Your journal</h2>
          <ul class="mt-4 flex flex-col gap-3">
            <li><%= link_to "Start your journal", new_registration_path, class: link_class %></li>
            <li><%= link_to "Sign in", new_session_path, class: link_class %></li>
          </ul>
        </nav>
      <% end %>

      <nav aria-labelledby="footer_learn_heading">
        <h2 id="footer_learn_heading" class="<%= heading_class %>">Learn</h2>
        <ul class="mt-4 flex flex-col gap-3">
          <li><%= link_to "Thinking traps", distortions_path, class: link_class %></li>
          <li><%= link_to "Privacy", privacy_path, class: link_class %></li>
          <li><%= link_to "Disclaimer", disclaimer_path, class: link_class %></li>
        </ul>
      </nav>

      <% if user %>
        <nav aria-labelledby="footer_account_heading">
          <h2 id="footer_account_heading" class="<%= heading_class %>">Account</h2>
          <ul class="mt-4 flex flex-col gap-3">
            <li><%= link_to "Settings", edit_settings_path, class: link_class %></li>
            <li><%= button_to "Sign out", session_path, method: :delete, class: "cursor-pointer #{link_class}" %></li>
          </ul>
        </nav>
      <% end %>
    </div>
  </div>

  <div class="flex flex-col gap-2 border-t border-stone-950/5 py-6 text-base/6 text-pretty text-stone-500 sm:flex-row sm:justify-between sm:gap-8 sm:text-sm/6 dark:border-white/10 dark:text-stone-400">
    <p>beckit is a self-help journaling tool. It does not provide therapy, diagnosis or medical advice. <%= link_to "Read the disclaimer", disclaimer_path, class: "underline decoration-stone-950/20 underline-offset-2 hover:decoration-stone-950/50 dark:decoration-white/30 dark:hover:decoration-white/60" %></p>
    <p class="shrink-0">&copy; <%= Date.current.year %> beckit</p>
  </div>
</footer>
