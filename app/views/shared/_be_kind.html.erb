<%# Shown above the crisis line on every page, with a different sentiment on each load. %>
<% words = kind_words %>
<section aria-labelledby="be_kind_heading" class="mb-10 rounded-3xl bg-[#F9F9F9] ring-1 ring-stone-950/5 dark:bg-white/[0.03] dark:ring-white/10 grid overflow-hidden sm:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] sm:items-center">
  <%= image_tag "be-kind/#{words[:image]}.svg", alt: words[:alt],
        width: 1200, height: 1000, loading: "lazy", decoding: "async", class: "aspect-[6/5] w-full object-cover" %>
  <div class="p-6 sm:p-10 lg:p-14">
    <h2 id="be_kind_heading" class="font-display text-2xl font-medium tracking-tight text-balance text-stone-900 sm:text-3xl dark:text-white"><%= words[:heading] %></h2>
    <p class="mt-3 max-w-[48ch] text-base/7 text-pretty text-stone-600 dark:text-stone-400"><%= words[:body] %></p>
  </div>
</section>
