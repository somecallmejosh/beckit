<%# locals: (insights:) %>
<% top = insights.frequency.select { it.count.positive? }.first(3).map { it.distortion.title } %>
<% slot = insights.busiest_slot %>
<% place = insights.top_place %>
<% shift = insights.feeling_shift %>
<%# The answer first, in one sentence; the charts below back it up, one at a time, each headed by the question it
    answers. One column with room between them, so each can be read on its own. %>
<div class="flex flex-col gap-16">
  <section aria-labelledby="in_short_heading" class="rounded-3xl panel-teal p-6 sm:p-10">
    <h2 id="in_short_heading" class="text-base/6 font-medium text-teal-800 sm:text-sm/6 dark:text-teal-300">In short</h2>
    <p class="mt-3 max-w-[36ch] font-display text-2xl/9 font-medium tracking-tight text-balance text-stone-900 sm:text-3xl/10 dark:text-white">
      <% if top.any? %>
        <%= top.to_sentence.downcase.upcase_first %> came up most, across <%= pluralize insights.total, "entry" %> <%= range_phrase(insights.range) %>.
      <% else %>
        You wrote <%= pluralize insights.total, "entry" %> <%= range_phrase(insights.range) %>.
      <% end %>
    </p>
    <%# Place names are free text, so they go after a colon rather than into the sentence. %>
    <% if slot || place || shift %>
      <ul role="list" class="mt-6 flex max-w-[60ch] flex-col gap-2 border-t border-teal-700/10 pt-6 text-base/7 text-pretty text-stone-700 dark:border-teal-400/20 dark:text-stone-300">
        <% if slot %>
          <li>You wrote most often on <%= when_phrase(*slot) %>.</li>
        <% end %>
        <% if place %>
          <li>Most common place: <%= place %>.</li>
        <% end %>
        <% if shift %>
          <li><%= feeling_shift_sentence(shift) %></li>
        <% end %>
      </ul>
    <% end %>
    <p class="mt-6 text-base/6 text-pretty text-teal-800 sm:text-sm/6 dark:text-teal-300">Pick a thinking trap to see when, where and with whom it shows up.</p>
  </section>

  <%= render "insights/weekly", insights: %>
  <%= render "insights/heatmap", insights: %>
  <%= render "insights/strongest", insights: %>
  <%= render "insights/pairs", insights: %>

  <details class="group/detail min-w-0 border-t border-stone-950/5 pt-10 dark:border-white/10">
    <summary class="flex cursor-pointer list-none flex-col gap-1 [&::-webkit-details-marker]:hidden">
      <span class="inline-flex items-center gap-2 font-display text-2xl font-medium tracking-tight text-stone-900 dark:text-white">
        Where and who, in detail
        <%= icon :plus, "size-5 text-teal-700 transition-transform group-open/detail:rotate-45 motion-reduce:transition-none dark:text-teal-400" %>
      </span>
      <span class="max-w-[60ch] text-base/6 text-pretty text-stone-500 sm:text-sm/6 dark:text-stone-400">Tables comparing each thinking trap across places and people.</span>
    </summary>
    <div class="mt-10 flex flex-col gap-12">
      <%= render "insights/matrix", insights:, title: "Where", noun: "place", groups: insights.by_location %>
      <%= render "insights/matrix", insights:, title: "Who was involved", noun: "person", groups: insights.by_person %>
    </div>
  </details>
</div>
