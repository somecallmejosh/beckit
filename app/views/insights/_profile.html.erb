<%# locals: (insights:) %>
<% distortion = insights.distortion %>
<% row = insights.focus_row %>
<article aria-labelledby="profile_heading" class="flex flex-col gap-12">
  <header class="flex flex-col gap-8">
    <div>
      <h2 id="profile_heading" class="font-display text-4xl font-medium tracking-tight text-balance text-stone-900 dark:text-white"><%= distortion.title %></h2>
      <p class="mt-3 max-w-[60ch] text-lg/7 text-pretty text-stone-600 dark:text-stone-400"><%= distortion.description %></p>
      <%= link_to "About this distortion", distortion, class: "mt-3 inline-block text-base/6 font-medium text-teal-700 hover:text-teal-600 sm:text-sm/6 dark:text-teal-400 dark:hover:text-teal-300", data: { turbo_frame: "_top" } %>
    </div>

    <% if row.count.positive? %>
      <dl class="grid grid-cols-2 gap-x-10 gap-y-6 border-y border-stone-950/5 py-6 sm:flex sm:flex-wrap dark:border-white/10">
        <div>
          <dt class="text-base/6 text-stone-500 sm:text-sm/6 dark:text-stone-400">Entries</dt>
          <dd class="mt-1 text-3xl font-medium tracking-tight text-stone-900 tabular-nums dark:text-white"><%= row.count %></dd>
        </div>
        <div>
          <dt class="text-base/6 text-stone-500 sm:text-sm/6 dark:text-stone-400">Share of entries</dt>
          <dd class="mt-1 text-3xl font-medium tracking-tight text-stone-900 tabular-nums dark:text-white"><%= percent(row.share) %></dd>
        </div>
        <% if row.avg_emotion %>
          <div class="col-span-2">
            <dt class="text-base/6 text-stone-500 sm:text-sm/6 dark:text-stone-400">Average intensity</dt>
            <dd class="mt-1 flex items-baseline gap-2">
              <span class="text-3xl font-medium tracking-tight text-stone-900 tabular-nums dark:text-white"><%= number_with_precision(row.avg_emotion, precision: 1) %><span class="text-lg text-stone-500 dark:text-stone-400">/10</span></span>
              <% if insights.overall_avg_emotion %>
                <span class="text-base/6 text-stone-500 tabular-nums sm:text-sm/6 dark:text-stone-400">overall <%= number_with_precision(insights.overall_avg_emotion, precision: 1) %></span>
              <% end %>
            </dd>
          </div>
        <% end %>
      </dl>
    <% end %>
  </header>

  <% if row.count.zero? %>
    <p class="max-w-[60ch] text-base/7 text-pretty text-stone-600 sm:text-sm/6 dark:text-stone-400">No entries with <%= distortion.title.downcase %> <%= range_phrase(insights.range) %>. Try a longer time range above.</p>
  <% else %>
    <%= render "insights/standouts", insights: %>

    <div class="grid gap-12 xl:grid-cols-2 xl:gap-x-12">
      <div class="min-w-0 border-t border-stone-950/5 pt-10 dark:border-white/10"><%= render "insights/weekly", insights: %></div>
      <div class="min-w-0 border-t border-stone-950/5 pt-10 dark:border-white/10"><%= render "insights/pairs", insights: %></div>
      <div class="min-w-0 border-t border-stone-950/5 pt-10 xl:col-span-2 dark:border-white/10"><%= render "insights/heatmap", insights: %></div>
      <div class="min-w-0 border-t border-stone-950/5 pt-10 dark:border-white/10"><%= render "insights/ranked_groups", insights:, column: :location, title: "Where", noun: "place" %></div>
      <div class="min-w-0 border-t border-stone-950/5 pt-10 dark:border-white/10"><%= render "insights/ranked_groups", insights:, column: :who_was_involved, title: "Who was involved", noun: "person" %></div>
      <div class="min-w-0 border-t border-stone-950/5 pt-10 xl:col-span-2 dark:border-white/10"><%= render "insights/recent_entries", insights: %></div>
    </div>
  <% end %>
</article>
