<%# locals: (id:, title:, description:, level: 2) %>
<div class="flex flex-col gap-1">
  <%= content_tag "h#{level}", title, id:, class: "font-display text-2xl font-medium tracking-tight text-stone-900 dark:text-white" %>
  <p class="max-w-[60ch] text-base/6 text-pretty text-stone-500 sm:text-sm/6 dark:text-stone-400"><%= description %></p>
</div>
