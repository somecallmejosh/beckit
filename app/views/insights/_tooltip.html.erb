<%# The shared hover tooltip; place inside an element with data-controller="tooltip". %>
<div data-tooltip-target="tip" hidden aria-hidden="true" class="pointer-events-none fixed z-20 max-w-64 rounded-lg bg-stone-900 px-3 py-2 text-sm/5 text-white shadow-lg dark:bg-white dark:text-stone-900">
  <p data-tooltip-target="heading" class="font-medium"></p>
  <p data-tooltip-target="detail" class="text-stone-300 tabular-nums dark:text-stone-600"></p>
</div>
