<% content_for :title, "Insights" %>
<%# Frame navigation with "advance" can cache a later state under an earlier URL, so back/forward
    re-fetch instead of restoring snapshots. %>
<% turbo_exempts_page_from_cache %>

<div class="page">
  <div class="flex flex-col gap-10">
    <%# Small screens put the drawing above the heading, as on the journal. %>
    <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between sm:gap-10">
      <div>
        <h1 class="font-display text-4xl font-medium tracking-tight text-balance text-stone-900 dark:text-white">Insights</h1>
        <p class="mt-3 max-w-[52ch] text-lg/7 text-pretty text-stone-600 dark:text-stone-400">A look back over your entries. Seeing which thinking traps come up, and when, makes them easier to catch next time.</p>
      </div>
      <%= image_tag "insights.svg", alt: "", width: 1380, height: 920, decoding: "async",
            class: "aspect-[3/2] w-full max-w-sm shrink-0 -scale-x-100 rounded-3xl object-cover ring-1 ring-stone-950/5 max-sm:order-first sm:w-64 lg:w-[500px] dark:ring-white/10 bg-stone-50 lg:bg-white lg:ring-0  lg:max-w-7xl" %>
    </div>

    <%# Rail, range and panel links swap only this frame and push the URL, so back/forward still work. %>
    <%= turbo_frame_tag "insights_body", data: { turbo_action: "advance" }, class: "group/frame flex flex-col gap-8" do %>
      <div class="flex flex-col gap-3 border-b border-stone-950/5 pb-6 sm:flex-row sm:items-center sm:justify-between dark:border-white/10">
        <nav aria-label="Time range" class="flex flex-wrap gap-1">
          <% InsightsHelper::RANGE_LABELS.each do |range, label| %>
            <%= nav_link_to label, insights_path(insights_link_params(@insights, range:)), active: @insights.range == range, class: "px-3 py-1.5" %>
          <% end %>
        </nav>
        <p class="text-base/6 text-stone-500 tabular-nums sm:text-sm/6 dark:text-stone-400"><%= pluralize @insights.total, "entry" %> <%= range_phrase(@insights.range) %></p>
      </div>

      <% if @insights.empty? %>
        <div class="rounded-3xl border border-dashed border-stone-950/10 px-6 py-14 text-center dark:border-white/10">
          <h2 class="font-display text-xl font-medium text-balance text-stone-900 dark:text-white">Nothing to show yet</h2>
          <p class="mx-auto mt-2 max-w-[48ch] text-base/7 text-pretty text-stone-600 sm:text-sm/6 dark:text-stone-400">There are no journal entries in this time range. Try a longer range, or come back after a few more entries.</p>
          <div class="mt-6">
            <%= link_to "Write an entry", new_situation_path, class: "btn btn-secondary", data: { turbo_frame: "_top" } %>
          </div>
        </div>
      <% else %>
        <div class="grid gap-8 lg:grid-cols-[16rem_minmax(0,1fr)] lg:gap-12">
          <%= render "insights/rail", insights: @insights %>

          <%# Small screens: a select instead of the rail, so every thinking trap is visible at once. %>
          <%= form_with url: insights_path, method: :get, class: "flex items-end gap-2 lg:hidden", data: { controller: "autosubmit" } do |form| %>
            <%= hidden_field_tag :range, @insights.range, id: nil %>
            <div class="flex min-w-0 flex-1 flex-col gap-2">
              <%= form.label :distortion_id, "Thinking trap", class: "field-label" %>
              <%= form.select :distortion_id,
                    options_for_select(@insights.frequency.map { [ "#{it.distortion.title} (#{it.count})", it.distortion.id ] }, @insights.distortion&.id),
                    { include_blank: "All thinking traps (#{@insights.total})" }, class: "field", data: { action: "autosubmit#submit" } %>
            </div>
            <%= form.submit "Show", name: nil, class: "btn btn-secondary", data: { autosubmit_target: "button" } %>
          <% end %>

          <div id="insights_panel" class="relative min-w-0 transition-opacity duration-200 group-aria-busy/frame:opacity-50 motion-reduce:transition-none"
               data-controller="tooltip" data-action="pointerover->tooltip#show pointerout->tooltip#hide focusin->tooltip#show focusout->tooltip#hide scroll@window->tooltip#dismiss">
            <%= render(@insights.distortion ? "insights/profile" : "insights/overview", insights: @insights) %>

            <%= render "insights/tooltip" %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
