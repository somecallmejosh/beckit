<%# locals: (insights:) %>
<% focus = insights.distortion %>
<% max = insights.heatmap.values.map(&:entries).max.to_i %>
<section aria-labelledby="heatmap_heading" class="flex min-w-0 flex-col gap-6">
  <%= render "insights/section_heading", level: (insights.distortion ? 3 : 2), id: "heatmap_heading", title: "When",
        description: focus ? "How often #{focus.title.downcase} came up at each time, compared with your overall rate. Numbers are entries with it." : "Entries by day of the week and time of day. Entries after midnight count toward the night before. Pick a distortion to see when it tends to show up." %>

  <table class="w-full table-fixed border-separate border-spacing-0.5 text-center text-base/6 tabular-nums sm:border-spacing-1 sm:text-sm/6">
    <thead>
      <tr>
        <td class="w-11"></td>
        <% InsightsHelper::DAY_PART_LABELS.each_value do |label, short, hours| %>
          <th scope="col" class="pb-1 text-xs/5 font-medium text-stone-500 dark:text-stone-400">
            <span class="sm:hidden" aria-hidden="true"><%= short %></span><span class="max-sm:sr-only"><%= label %></span>
            <span class="block font-normal max-sm:hidden"><%= hours %></span>
          </th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% DistortionInsights::WEEKDAYS.each do |wday| %>
        <tr>
          <th scope="row" class="pr-1 text-left text-xs/5 font-medium text-stone-500 dark:text-stone-400"><%= InsightsHelper::WEEKDAY_LABELS[wday] %></th>
          <% DistortionInsights::DAY_PARTS.each do |part| %>
            <% cell = insights.heatmap[[ wday, part ]] %>
            <% where = "#{Date::DAYNAMES[wday]} #{part}" %>
            <% if focus %>
              <% detail = "#{cell.matches} of #{pluralize cell.entries, "entry"} · #{lift_label(cell.lift)}" %>
              <td class="relative h-10 rounded-md hover:ring-2 hover:ring-stone-950/25 hover:ring-inset dark:hover:ring-white/40 <%= lift_class(cell.lift) %>" data-tooltip="<%= where %>" data-tooltip-detail="<%= detail %>"><span class="sr-only"><%= where %>: <%= detail %></span><span aria-hidden="true"><%= cell.matches if cell.entries.positive? %></span></td>
            <% else %>
              <% detail = pluralize(cell.entries, "entry") %>
              <td class="relative h-10 rounded-md hover:ring-2 hover:ring-stone-950/25 hover:ring-inset dark:hover:ring-white/40 <%= heat_class(cell.entries, max) %>" data-tooltip="<%= where %>" data-tooltip-detail="<%= detail %>"><span class="sr-only"><%= where %>: <%= detail %></span><span aria-hidden="true"><%= cell.entries if cell.entries.positive? %></span></td>
            <% end %>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>

  <% if focus %>
    <%= render "insights/lift_legend" %>
  <% else %>
    <div class="flex items-center gap-2 text-base/6 text-stone-600 sm:text-xs/5 dark:text-stone-400">
      <span>Fewer</span>
      <% 1.upto(4) do |level| %><span aria-hidden="true" class="size-3 rounded-sm ring-1 ring-stone-950/10 ring-inset dark:ring-white/10 <%= InsightsHelper::HEAT_CLASSES[level] %>"></span><% end %>
      <span>More entries</span>
    </div>
  <% end %>
</section>
