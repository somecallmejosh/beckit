<%# locals: (insights:) %>
<nav aria-label="Thinking traps" data-controller="scroll-active" class="min-w-0 max-lg:hidden lg:sticky lg:top-24 lg:self-start">
  <ul role="list" class="-mx-4 flex snap-x gap-2 overflow-x-auto px-4 pb-1 sm:-mx-6 sm:px-6 lg:mx-0 lg:flex-col lg:gap-0.5 lg:overflow-visible lg:px-0 lg:pb-0">
    <li class="shrink-0 lg:mb-2 lg:border-b lg:border-stone-950/5 lg:pb-2 lg:dark:border-white/10">
      <%= rail_link "All thinking traps", insights.total, insights_path(range: insights.range), active: insights.distortion.nil? %>
    </li>
    <% insights.frequency.each do |row| %>
      <li class="shrink-0">
        <%= rail_link row.distortion.title, row.count, insights_path(range: insights.range, distortion_id: row.distortion.id), active: row.distortion == insights.distortion %>
      </li>
    <% end %>
  </ul>
</nav>
