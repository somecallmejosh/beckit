<!DOCTYPE html>
<html lang="en" class="bg-white antialiased dark:bg-stone-950">
  <head>
    <title><%= content_for(:title) || "beckit" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="beckit">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="color-scheme" content="light dark">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <meta property="og:site_name" content="beckit">
    <meta property="og:type" content="website">
    <meta property="og:title" content="<%= content_for(:title) || "beckit" %>">
    <meta property="og:description" content="A private journal for spotting thinking traps, like catastrophizing or mind reading, and weighing them against the evidence.">
    <meta property="og:url" content="<%= request.original_url %>">
    <meta property="og:image" content="<%= "#{request.base_url}/og-image.png" %>">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="beckit: Notice the thought. Name the pattern.">
    <meta name="twitter:card" content="summary_large_image">

    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <link rel="preconnect" href="https://rsms.me/">
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..700;1,400..700&display=swap">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="font-sans text-stone-900 dark:text-stone-100">
    <div class="relative isolate flex min-h-dvh flex-col">

      <% if authenticated? && !content_for?(:bare_layout) %>

        <header class="relative sticky top-0 bg-white shadow z-50">
          <div class="mx-auto flex max-w-7xl items-center gap-6 px-4 py-5 sm:px-6 lg:px-8">
            <a href="/" aria-label="Homepage" class="shrink-0"><%= logo_tag %></a>

            <nav aria-label="Main" class="flex items-center gap-1 max-sm:hidden">
              <%= nav_link_to "Journal", situations_path, active: controller_name == "situations", class: "px-3 py-1.5" %>
              <%= nav_link_to "Insights", insights_path, active: controller_name == "insights", class: "px-3 py-1.5" %>
            </nav>

            <div class="ml-auto flex items-center gap-3 max-sm:hidden">
              <%= nav_link_to capture { render("shared/avatar", user: Current.user, size: "size-7", text: "text-[0.6875rem]") + Current.user.first_name }, edit_settings_path, active: controller_name == "settings", class: "flex items-center gap-2 py-1 pr-3 pl-1" %>
              <%= button_to "Sign out", session_path, method: :delete, class: "btn-sm btn-ghost" %>
            </div>

            <details class="group ml-auto sm:hidden">
              <summary class="relative flex size-9 cursor-pointer list-none items-center justify-center rounded-full text-stone-700 hover:bg-stone-950/5 dark:text-stone-200 dark:hover:bg-white/5 [&::-webkit-details-marker]:hidden">
                <span class="sr-only">Open menu</span>
                <%= icon :bars_3, "group-open:hidden" %>
                <%= icon :x_mark, "group-not-open:hidden" %>
                <span class="absolute top-1/2 left-1/2 size-[max(100%,3rem)] -translate-1/2 pointer-fine:hidden" aria-hidden="true"></span>
              </summary>
              <div class="absolute inset-x-4 top-full z-10 rounded-2xl bg-white p-3 shadow-lg ring-1 ring-stone-950/5 dark:bg-stone-900 dark:shadow-none dark:inset-ring dark:inset-ring-white/10 dark:ring-0">
                <nav aria-label="Mobile" class="flex flex-col gap-1">
                  <%= nav_link_to "Journal", situations_path, active: controller_name == "situations", class: "px-4 py-2.5" %>
                  <%= nav_link_to "Distortions", distortions_path, active: controller_name == "distortions", class: "px-4 py-2.5" %>
                  <%= nav_link_to "Insights", insights_path, active: controller_name == "insights", class: "px-4 py-2.5" %>
                </nav>
                <div class="mt-3 flex items-center justify-between gap-3 border-t border-stone-950/5 px-4 pt-3 dark:border-white/10">
                  <%= nav_link_to capture { render("shared/avatar", user: Current.user, size: "size-8", text: "text-xs") + tag.span(Current.user.first_name, class: "truncate") }, edit_settings_path, active: controller_name == "settings", class: "-ml-3 flex min-w-0 items-center gap-2.5 py-1 pr-3 pl-1" %>
                  <%= button_to "Sign out", session_path, method: :delete, class: "btn-sm btn-secondary" %>
                </div>
              </div>
            </details>
          </div>
        </header>
      <% end %>

      <main class="flex-1">
        <%= yield %>
      </main>

      <footer>
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pb-8">
          <%= render "shared/crisis_line", user: (Current.user if authenticated?) %>
          <%= yield :footer_note %>
          <%= link_to "Distortions", distortions_path, class: "border-b border-white inline-flex text-base/6 text-stone-900 text-sm rounded-full px-3 py-1 bg-stone-100 dark:bg-stone-800" %>
        </div>
      </footer>
    </div>
  </body>
</html>
