<%# Error pages only. Touches nothing but assets and routes, so it renders even when the database is down. %>
<!DOCTYPE html>
<html lang="en" class="bg-white antialiased dark:bg-stone-950">
  <head>
    <title><%= content_for(:title) %> · beckit</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <meta name="robots" content="noindex">
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#0c0a09" media="(prefers-color-scheme: dark)">

    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <%= stylesheet_link_tag :app %>
  </head>

  <body class="font-sans text-stone-900 dark:text-stone-100">
    <div class="flex min-h-dvh flex-col">
      <header>
        <div class="mx-auto flex h-16 max-w-7xl items-center px-4 sm:px-6 lg:px-8">
          <a href="/" aria-label="beckit home" class="shrink-0 hover:opacity-75"><%= logo_tag %></a>
        </div>
      </header>

      <main class="flex-1">
        <%= yield %>
      </main>

      <footer class="mx-auto w-full max-w-7xl px-4 pb-8 sm:px-6 lg:px-8">
        <div class="border-t border-stone-950/5 py-10 dark:border-white/10"><%= render "shared/crisis_line", user: nil %></div>
      </footer>
    </div>
  </body>
</html>
