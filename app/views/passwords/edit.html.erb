<% content_for :title, "Reset password" %>

<%= render layout: "shared/auth", locals: { title: "Choose a new password" } do %>
  <%= form_with url: password_path(params[:token]), method: :put, class: "flex flex-col gap-6" do |form| %>
    <%= render "shared/new_password_fields", form:, label: "New password", confirm_label: "Confirm new password", autofocus: true %>

    <%= form.submit "Save password", class: "btn btn-primary w-full" %>
  <% end %>
<% end %>
