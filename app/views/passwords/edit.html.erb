<% content_for :title, "Reset password" %>

<%= render layout: "shared/auth", locals: { title: "Choose a new password" } do %>
  <%= form_with url: password_path(params[:token]), method: :put, class: "flex flex-col gap-6" do |form| %>
    <div class="flex flex-col gap-2">
      <%= form.label :password, "New password", class: "field-label" %>
      <%= form.password_field :password, required: true, autofocus: true, autocomplete: "new-password", maxlength: 72, class: "field" %>
    </div>

    <div class="flex flex-col gap-2">
      <%= form.label :password_confirmation, "Confirm new password", class: "field-label" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "field" %>
    </div>

    <%= form.submit "Save password", class: "btn btn-primary w-full" %>
  <% end %>
<% end %>
