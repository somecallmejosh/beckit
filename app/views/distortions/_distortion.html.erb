<li id="<%= dom_id distortion %>" class="flex flex-col gap-3 border-t border-stone-950/5 py-6 sm:flex-row sm:items-start sm:justify-between sm:gap-8 dark:border-white/10">
  <div class="min-w-0">
    <h2 class="font-display text-xl font-medium text-balance text-stone-900 dark:text-white">
      <%= link_to distortion.title, distortion, class: "hover:text-teal-800 dark:hover:text-teal-300" %>
    </h2>
    <p class="mt-1.5 max-w-[56ch] text-base/7 text-pretty text-stone-600 sm:text-sm/6 dark:text-stone-400"><%= distortion.description %></p>
  </div>
  <% if Current.user.admin? %>
    <%= link_to "Edit", edit_distortion_path(distortion), class: "btn-sm btn-secondary shrink-0 self-start", aria: { label: "Edit #{distortion.title}" } %>
  <% end %>
</li>
