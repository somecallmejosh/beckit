<% content_for :title, @distortion.title %>
<% content_for :og_description, @distortion.description %>
<% if @distortion.og_image.attached? %>
  <%# Proxy URL: served directly with a public cache, unlike the redirect URL, whose signed target expires in minutes. %>
  <% content_for :og_image, rails_storage_proxy_path(@distortion.og_image) %>
  <% content_for :og_image_alt, "beckit thinking trap: #{@distortion.title}" %>
<% end %>

<div class="page">
  <div class="flex flex-col gap-6">
    <%= link_to distortions_path, class: "btn-sm btn-ghost -ml-3 self-start" do %>
      <%= icon :arrow_left %> Thinking traps
    <% end %>

    <%= render "shared/flash" %>

    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_22rem] lg:gap-16">
      <div class="flex min-w-0 flex-col gap-6">
        <div>
          <h1 class="font-display text-4xl font-medium tracking-tight text-balance text-stone-900 dark:text-white"><%= @distortion.title %></h1>
          <p class="mt-4 max-w-[52ch] text-lg/8 text-pretty text-stone-600 dark:text-stone-400"><%= @distortion.description %></p>
        </div>
        <% if @distortion.details.present? %>
          <div class="rich-text max-w-[65ch] border-t border-stone-950/5 pt-8 dark:border-white/10"><%= @distortion.details %></div>
        <% end %>
        <% if Current.user&.admin? %>
          <div class="flex items-center gap-2">
            <%= link_to "Edit", edit_distortion_path(@distortion), class: "btn btn-secondary" %>
            <%= button_to "Delete", @distortion, method: :delete, class: "btn btn-danger", data: { turbo_confirm: "Delete this thinking trap? It will be removed from any entries that use it." } %>
          </div>
        <% end %>
      </div>

      <div class="flex flex-col gap-6 self-start max-lg:w-full max-lg:max-w-md">
        <%# Illustration of the trap; decorative, since the title and description carry the meaning. %>
        <% if @distortion.image.attached? %>
          <%= image_tag distortion_image_source(@distortion), alt: "", width: 720, height: 900, decoding: "async",
                class: "aspect-[4/5] w-full rounded-3xl object-cover ring-1 ring-stone-950/5 dark:ring-white/10 bg-stone-50" %>
        <% end %>

        <% if Current.user %>
          <section aria-labelledby="recent_entries_heading" class="flex flex-col gap-4 panel p-6">
            <div class="flex items-baseline justify-between gap-4">
              <h2 id="recent_entries_heading" class="text-base/6 font-medium text-stone-900 sm:text-sm/6 dark:text-white">Your recent entries</h2>
              <p class="text-base/6 text-stone-500 tabular-nums sm:text-sm/6 dark:text-stone-400"><%= pluralize @entry_count, "entry" %></p>
            </div>

            <% if @recent_entries.any? %>
              <ul role="list" class="flex flex-col gap-1">
                <% @recent_entries.each do |situation| %>
                  <li>
                    <%= link_to situation, class: "row-link flex flex-col py-1.5" do %>
                      <span class="flex flex-wrap items-center gap-x-2 gap-y-1">
                        <time datetime="<%= situation.date.iso8601 %>" class="text-base/6 text-stone-500 sm:text-xs/5 dark:text-stone-400"><%= l situation.date, format: :entry_date %></time>
                        <%= in_progress_badge situation %>
                      </span>
                      <span class="truncate text-base/6 font-medium text-stone-900 sm:text-sm/6 dark:text-white"><%= situation.display_title %></span>
                    <% end %>
                  </li>
                <% end %>
              </ul>
              <%= link_to "See patterns in Insights", insights_path(distortion_id: @distortion.id, range: "all"), class: "btn-sm btn-secondary self-start" %>
            <% else %>
              <p class="text-base/6 text-pretty text-stone-600 sm:text-sm/6 dark:text-stone-400">You haven't tagged an entry with <%= @distortion.title.downcase %> yet.</p>
            <% end %>
          </section>
        <% else %>
          <section aria-labelledby="start_heading" class="flex flex-col gap-4 rounded-3xl panel-teal p-6">
            <h2 id="start_heading" class="text-base/6 font-medium text-stone-900 sm:text-sm/6 dark:text-white">Notice this in your own thinking?</h2>
            <p class="text-base/6 text-pretty text-stone-600 sm:text-sm/6 dark:text-stone-400">beckit is a private journal for writing down hard moments, naming the traps that show up, and weighing them against the evidence.</p>
            <%= link_to "Start your journal", new_registration_path, class: "btn-sm btn-primary self-start" %>
          </section>
        <% end %>
      </div>
    </div>
  </div>
</div>
