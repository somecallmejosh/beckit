<%# locals: (user:) %>
<%# One plant, a stage for every ten finished entries (User#finished_entries_count, which only goes up). Stages still
    to come are pale sketches; reached ones are drawn in full and their teal detail floats. The pots stand on a shared
    shelf: one row of six from lg, three, then two. %>
<% finished = user.finished_entries_count %>
<% upcoming = Milestone.all.find { !it.earned_by?(finished) } %>
<section id="plant" aria-labelledby="milestones_heading" class="form-section scroll-mt-24">
  <div class="flex flex-col gap-1">
    <h2 id="milestones_heading" class="font-display text-2xl font-medium tracking-tight text-stone-900 dark:text-white">Your plant</h2>
    <p class="field-hint">It grows a little for every ten entries you finish.</p>
  </div>

  <div class="flex min-w-0 flex-col gap-6">
    <p class="text-lg/7 text-pretty text-stone-700 sm:text-base/7 dark:text-stone-300">
      You've finished <%= pluralize finished, "entry" %>.
      <% if upcoming.nil? %>
        Your plant is fully grown.
      <% else %>
        <%= upcoming.entries - finished %> more until it's <%= upcoming.becoming %>.
      <% end %>
    </p>

    <ol role="list" class="grid grid-cols-2 gap-y-8 sm:grid-cols-3 lg:grid-cols-6">
      <% Milestone.all.each do |milestone| %>
        <% earned = milestone.earned_by?(finished) %>
        <li class="flex flex-col items-center text-center">
          <div class="flex w-full justify-center border-b border-stone-950/10 dark:border-white/10">
            <%= image_tag "milestones/#{milestone.slug}#{"-locked" unless earned}.svg", alt: "", width: 900, height: 900, loading: "lazy", decoding: "async",
                  class: "aspect-square w-full max-w-32" %>
          </div>
          <p class="mt-3 text-base/6 font-medium sm:text-sm/6 <%= earned ? "text-stone-900 dark:text-white" : "text-stone-400 dark:text-stone-500" %>">
            <%= milestone.name %><span class="sr-only"><%= earned ? ", reached" : ", not reached yet" %></span>
          </p>
          <p class="text-base/6 tabular-nums sm:text-sm/6 <%= earned ? "text-teal-700 dark:text-teal-400" : "text-stone-400 dark:text-stone-500" %>"><%= pluralize milestone.entries, "entry" %></p>
        </li>
      <% end %>
    </ol>
  </div>
</section>
