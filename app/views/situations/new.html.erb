<% content_for :title, "New entry" %>

<div class="page">
  <div class="flex flex-col gap-10">
    <div class="flex flex-col gap-6">
      <%= link_to situations_path, class: "btn-sm btn-ghost -ml-3 self-start" do %>
        <%= icon :arrow_left %> Journal
      <% end %>
      <div>
        <h1 class="font-display text-4xl font-medium tracking-tight text-balance text-stone-900 dark:text-white">New entry</h1>
        <p class="mt-3 max-w-[48ch] text-lg/7 text-pretty text-stone-600 dark:text-stone-400">Take a breath. There's no right or wrong way to fill this in.</p>
      </div>
    </div>

    <%= render "form", situation: @situation %>
  </div>
</div>
