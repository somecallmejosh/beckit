<%# locals: (form:, situation:) %>
<%= render "situations/your_thought", situation: %>

<%# Side by side from md, so for and against read as one question with two sides, as they do on the entry. Each column is a
    subgrid of the same two rows, so the writing lines up even when one side's prompt runs longer. %>
<% traps = situation.distortions.sort_by(&:title).map { it.title.downcase }.to_sentence %>
<% questions = trap_questions(situation) %>
<div class="grid gap-10 md:grid-cols-2 md:gap-x-8 md:gap-y-4">
  <div class="grid gap-4 md:row-span-2 md:grid-rows-subgrid">
    <div>
      <%= form.label :evidence_for, "What's backing this thought up?", class: "question" %>
      <p id="evidence_for_hint" class="mt-1 field-hint">Facts, not feelings. What would a camera have seen?</p>
    </div>
    <%= form.textarea :evidence_for, rows: 2, class: "writing", placeholder: "My voice shook on the first slide…",
          aria: { describedby: "evidence_for_hint" } %>
  </div>

  <div class="grid gap-4 md:row-span-2 md:grid-rows-subgrid">
    <div data-controller="prompts" data-prompts-questions-value="<%= questions.to_json %>">
      <%= form.label :evidence_against, "What doesn't quite fit the story?", class: "question" %>
      <p id="evidence_against_hint" class="mt-1 field-hint">
        <%= traps.present? ? "You spotted #{traps}. Try asking:" : "Try asking:" %>
        <span data-prompts-target="text" aria-live="polite" class="font-display text-stone-800 italic dark:text-stone-200"><%= questions.first %></span>
      </p>
      <button type="button" hidden data-prompts-target="another" data-action="prompts#another"
              class="mt-2 inline-flex cursor-pointer items-center gap-1 text-base/6 font-medium text-teal-700 underline decoration-teal-700/30 underline-offset-4 hover:text-teal-600 hover:decoration-teal-600 sm:text-sm/6 dark:text-teal-400 dark:decoration-teal-400/40 dark:hover:text-teal-300">
        Another question
      </button>
    </div>
    <%= form.textarea :evidence_against, rows: 2, class: "writing", placeholder: "Two people asked follow-up questions…",
          aria: { describedby: "evidence_against_hint" } %>
  </div>
</div>
