<%# locals: (form:, situation:) %>
<%# The thought from the first step, repeated so it doesn't have to be remembered while weighing it up. %>
<% if situation.thought_imagery.present? %>
  <figure class="rounded-2xl panel-teal px-4 py-3">
    <figcaption class="text-base/6 font-medium text-teal-800 sm:text-sm/6 dark:text-teal-300">Your thought</figcaption>
    <blockquote class="mt-1 line-clamp-4 font-display text-lg/7 text-pretty text-stone-800 italic dark:text-stone-100"><%= situation.thought_imagery %></blockquote>
  </figure>
<% end %>

<div class="flex flex-col gap-2">
  <div>
    <%= form.label :evidence_for, "Evidence that validates the thought", class: "field-label" %>
    <p id="evidence_for_hint" class="field-hint">What makes you think the thought is true?</p>
  </div>
  <%= form.textarea :evidence_for, rows: 4, class: "field", aria: { describedby: "evidence_for_hint" } %>
</div>

<div class="flex flex-col gap-2">
  <div>
    <%= form.label :evidence_against, "Evidence that doesn't validate it", class: "field-label" %>
    <p id="evidence_against_hint" class="field-hint">What are some signs that the thought might not be true?</p>
  </div>
  <%= form.textarea :evidence_against, rows: 4, class: "field", aria: { describedby: "evidence_against_hint" } %>
</div>

<div class="flex flex-col gap-2">
  <div>
    <%= form.label :balanced_thought, "A more balanced thought", class: "field-label" %>
    <p id="balanced_thought_hint" class="field-hint">What might you say to a friend who was in the same situation?</p>
  </div>
  <%= form.textarea :balanced_thought, rows: 4, required: true, class: "field", aria: { describedby: "balanced_thought_hint" } %>
</div>

<%= render "situations/intensity", form:, attribute: :emotion_level_after, legend: "How strong is the feeling now?",
      hint: "Optional. Rate it again after writing the balanced thought, on the same 0 to 10 scale." %>
