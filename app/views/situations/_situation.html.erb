<li id="<%= dom_id situation %>">
  <%= link_to situation, class: "group -mx-4 flex flex-col gap-3 rounded-2xl px-4 py-6 hover:bg-stone-950/2.5 sm:flex-row sm:items-start sm:justify-between sm:gap-8 dark:hover:bg-white/2.5" do %>
    <div class="min-w-0 flex-1">
      <p class="text-base/6 text-stone-500 sm:text-sm/6 dark:text-stone-400">
        <time datetime="<%= situation.date.iso8601 %>"><%= l situation.date, format: :entry_date %></time>
        <% if situation.location.present? %>
          <span aria-hidden="true">&middot;</span> <%= situation.location %>
        <% end %>
      </p>
      <h2 class="mt-1 font-display text-xl font-medium text-balance text-stone-900 group-hover:text-teal-800 dark:text-white dark:group-hover:text-teal-300"><%= situation.title %></h2>
      <% if situation.balanced_thought.present? %>
        <p class="mt-2 line-clamp-2 text-base/7 text-pretty text-stone-600 sm:text-sm/6 dark:text-stone-400"><%= situation.balanced_thought %></p>
      <% end %>
      <% if situation.distortions.any? %>
        <ul role="list" class="mt-3 flex flex-wrap gap-1.5">
          <% situation.distortions.sort_by(&:title).each do |distortion| %>
            <li class="badge"><%= distortion.title %></li>
          <% end %>
        </ul>
      <% end %>
    </div>
    <% if situation.emotion_level %>
      <div class="shrink-0 sm:pt-7">
        <%= render "shared/emotion_level", level: situation.emotion_level %>
      </div>
    <% end %>
  <% end %>
</li>
