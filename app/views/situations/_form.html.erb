<%# Drafts are keyed per user and per entry, so a shared tab never shows someone else's text. %>
<%= form_with(model: situation, class: "flex flex-col gap-12", data: {
      controller: "draft", draft_key_value: [ "draft", Current.user.id, situation.persisted? ? situation.id : "new" ].join(":"),
      action: "input->draft#save change->draft#save turbo:submit-end->draft#submitted" }) do |form| %>
  <div data-draft-target="notice" hidden role="status" class="flex flex-wrap items-center justify-between gap-3 rounded-2xl bg-teal-50 px-4 py-3 text-base/6 text-teal-900 ring-1 ring-teal-700/10 sm:text-sm/6 dark:bg-white/5 dark:text-teal-200 dark:ring-white/10">
    <p>We restored the text you hadn't saved yet.</p>
    <button type="button" class="btn-sm btn-ghost" data-action="draft#discard">Discard draft</button>
  </div>

  <%= render "shared/form_errors", record: situation %>

  <%# Thought and feeling come first: they are what's pressing when someone opens this form. %>
  <fieldset class="form-section">
    <legend class="contents">
      <span class="flex flex-col gap-1">
        <span class="text-base/6 font-medium text-teal-700 sm:text-sm/6 dark:text-teal-400">Step 1</span>
        <span class="font-display text-2xl font-medium tracking-tight text-stone-900 dark:text-white">What's on your mind</span>
      </span>
    </legend>

    <div class="flex max-w-4xl min-w-0 flex-col gap-6">
      <div class="flex flex-col gap-2">
        <div>
          <%= form.label :thought_imagery, "What went through your mind?", class: "field-label" %>
          <p id="thought_imagery_hint" class="field-hint">Words, images, or memories that came up in the moment.</p>
        </div>
        <%= form.textarea :thought_imagery, rows: 4, class: "field", aria: { describedby: "thought_imagery_hint" } %>
      </div>

      <fieldset aria-describedby="emotions_hint" class="flex flex-col gap-2">
        <legend class="field-label">What did you feel?</legend>
        <p id="emotions_hint" class="field-hint">Pick any that fit, or none.</p>
        <%= hidden_field_tag "situation[emotions][]", "", id: nil %>
        <div class="flex flex-wrap gap-2 pt-1">
          <% Situation::EMOTIONS.each do |emotion| %>
            <%= render "chip", name: "situation[emotions][]", value: emotion, label: emotion, checked: situation.emotions.include?(emotion), id: "situation_emotions_#{emotion.downcase}" %>
          <% end %>
        </div>
      </fieldset>

      <%= render "intensity", form:, attribute: :emotion_level, legend: "How strong was the feeling?",
            hint: "0 is barely noticeable, 10 is the most intense you can imagine." %>
    </div>
  </fieldset>

  <fieldset class="form-section border-t border-stone-950/5 pt-12 dark:border-white/10">
    <legend class="contents">
      <span class="flex flex-col gap-1">
        <span class="text-base/6 font-medium text-teal-700 sm:text-sm/6 dark:text-teal-400">Step 2</span>
        <span class="font-display text-2xl font-medium tracking-tight text-stone-900 dark:text-white">What happened</span>
      </span>
    </legend>

    <div class="flex max-w-4xl min-w-0 flex-col gap-6">
      <div class="grid gap-6 sm:grid-cols-2">
        <div class="flex flex-col gap-2">
          <%= form.label :date, "When did this occur?", class: "field-label" %>
          <%= form.datetime_field :date, required: true, step: 60, value: situation.date&.strftime("%Y-%m-%dT%H:%M"), class: "field" %>
        </div>
        <div class="flex flex-col gap-2">
          <%= form.label :location, "Where were you when it happened?", class: "field-label" %>
          <%= form.text_field :location, placeholder: "Optional", list: "location_options", autocomplete: "off", class: "field" %>
          <%= render "suggestions", id: "location_options", options: @location_options %>
        </div>
      </div>

      <div class="flex flex-col gap-2">
        <%= form.label :who_was_involved, "Who was involved?", class: "field-label" %>
        <%= form.text_field :who_was_involved, placeholder: "Optional", list: "who_options", autocomplete: "off", class: "field" %>
        <%= render "suggestions", id: "who_options", options: @who_options %>
      </div>

      <div class="flex flex-col gap-2">
        <div>
          <%= form.label :title, "Give this entry a short name", class: "field-label" %>
          <p id="title_hint" class="field-hint">Optional. Leave it blank to use the start of your thought.</p>
        </div>
        <%= form.text_field :title, placeholder: "e.g. Presentation at work", class: "field", aria: { describedby: "title_hint" } %>
      </div>
    </div>
  </fieldset>

  <fieldset class="form-section border-t border-stone-950/5 pt-12 dark:border-white/10">
    <legend class="contents">
      <span class="flex flex-col gap-1">
        <span class="text-base/6 font-medium text-teal-700 sm:text-sm/6 dark:text-teal-400">Step 3</span>
        <span class="font-display text-2xl font-medium tracking-tight text-stone-900 dark:text-white">Name the pattern</span>
      </span>
    </legend>

    <div class="flex max-w-4xl min-w-0 flex-col gap-4">
      <fieldset aria-describedby="distortions_hint" class="flex flex-col gap-2">
        <legend class="field-label">Which thinking traps might be at play?</legend>
        <p id="distortions_hint" class="field-hint">Choose any that fit. It's okay to leave these blank.<% if @distortions_used %> The ones you use most are first.<% end %></p>
        <%= hidden_field_tag "situation[distortion_ids][]", "", id: nil %>
        <div class="flex flex-wrap gap-2 pt-1">
          <% @distortions.each do |distortion| %>
            <% checkbox_id = "situation_distortion_ids_#{distortion.id}" %>
            <%= render "chip", name: "situation[distortion_ids][]", value: distortion.id, label: distortion.title,
                  checked: situation.distortion_ids.include?(distortion.id), id: checkbox_id, describedby: "#{checkbox_id}_description" %>
          <% end %>
        </div>
      </fieldset>

      <details class="group/meanings">
        <summary class="inline-flex cursor-pointer list-none items-center gap-1 text-base/6 font-medium text-teal-700 hover:text-teal-600 sm:text-sm/6 dark:text-teal-400 dark:hover:text-teal-300 [&::-webkit-details-marker]:hidden">
          <span class="group-open/meanings:hidden">What do these mean?</span><span class="group-not-open/meanings:hidden">Hide descriptions</span>
        </summary>
        <dl class="mt-4 grid gap-x-8 gap-y-4 text-base/6 sm:grid-cols-2 sm:text-sm/6">
          <% @distortions.each do |distortion| %>
            <div>
              <dt class="font-medium text-stone-900 dark:text-white"><%= distortion.title %></dt>
              <dd id="situation_distortion_ids_<%= distortion.id %>_description" class="mt-0.5 text-pretty text-stone-500 dark:text-stone-400"><%= distortion.description %></dd>
            </div>
          <% end %>
        </dl>
      </details>
    </div>
  </fieldset>

  <fieldset class="form-section border-t border-stone-950/5 pt-12 dark:border-white/10">
    <legend class="contents">
      <span class="flex flex-col gap-1">
        <span class="text-base/6 font-medium text-teal-700 sm:text-sm/6 dark:text-teal-400">Step 4</span>
        <span class="font-display text-2xl font-medium tracking-tight text-stone-900 dark:text-white">Weigh it up</span>
      </span>
    </legend>

    <div class="flex max-w-4xl min-w-0 flex-col gap-6">
      <div class="grid gap-6 sm:grid-cols-2">
        <div class="flex flex-col gap-2">
          <div>
            <%= form.label :evidence_for, "Evidence that validates the thought", class: "field-label" %>
            <p class="field-hint">What makes you think the thought is true?</p>
          </div>
          <%= form.textarea :evidence_for, rows: 5, class: "field" %>
        </div>
        <div class="flex flex-col gap-2">
          <div>
            <%= form.label :evidence_against, "Evidence that doesn't validate it", class: "field-label" %>
            <p class="field-hint">What are some signs that the thought might not be true?</p>
          </div>
          <%= form.textarea :evidence_against, rows: 5, class: "field" %>
        </div>
      </div>

      <div class="flex flex-col gap-2">
        <div>
          <%= form.label :balanced_thought, "A more balanced thought", class: "field-label" %>
          <p id="balanced_thought_hint" class="field-hint">What might you say to a friend who was in the same situation?</p>
        </div>
        <%= form.textarea :balanced_thought, rows: 4, class: "field", aria: { describedby: "balanced_thought_hint" } %>
      </div>

      <%= render "intensity", form:, attribute: :emotion_level_after, legend: "How strong is the feeling now?",
            hint: "Optional. Rate it again after writing the balanced thought, on the same 0 to 10 scale." %>
    </div>
  </fieldset>

  <div class="form-section border-t border-stone-950/5 pt-8 dark:border-white/10">
    <div class="flex max-w-4xl flex-col-reverse gap-3 sm:flex-row sm:justify-end lg:col-start-2">
      <%= link_to "Cancel", (situation.persisted? ? situation : situations_path), class: "btn btn-ghost", data: { action: "draft#clear" } %>
      <%= form.submit "Save entry", class: "btn btn-primary" %>
    </div>
  </div>
<% end %>
