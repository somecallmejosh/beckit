<% content_for :title, @situation.title %>

<div class="page">
  <div class="flex flex-col gap-6">
    <%= link_to situations_path, class: "btn-sm btn-ghost -ml-3 self-start" do %>
      <%= icon :arrow_left %> Journal
    <% end %>

    <%= render "shared/flash" %>

    <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
      <article class="flex min-w-0 flex-col gap-10 lg:col-span-8">
        <div>
          <p class="text-base/6 font-medium text-teal-700 sm:text-sm/6 dark:text-teal-400">
            <time datetime="<%= @situation.date.iso8601 %>"><%= l @situation.date, format: :entry %></time>
          </p>
          <h1 class="mt-2 font-display text-4xl font-medium tracking-tight text-balance text-stone-900 dark:text-white"><%= @situation.title %></h1>
        </div>

        <section aria-labelledby="thought_heading" class="flex flex-col gap-2">
          <h2 id="thought_heading" class="text-base/6 font-medium text-stone-900 sm:text-sm/6 dark:text-white">What went through your mind</h2>
          <p class="max-w-[65ch] text-lg/8 text-pretty text-stone-700 dark:text-stone-300"><%= @situation.thought_imagery.presence || "Not recorded" %></p>
        </section>

        <div class="grid gap-8 border-t border-stone-950/5 pt-10 md:grid-cols-2 md:gap-10 dark:border-white/10">
          <% [ [ "Evidence for", @situation.evidence_for ], [ "Evidence against", @situation.evidence_against ] ].each do |label, text| %>
            <section class="flex flex-col gap-2">
              <h2 class="text-base/6 font-medium text-stone-900 sm:text-sm/6 dark:text-white"><%= label %></h2>
              <div class="text-base/7 text-pretty text-stone-600 sm:text-sm/6 dark:text-stone-400 [&_p+p]:mt-3">
                <%= text.present? ? simple_format(text, {}, wrapper_tag: "p") : "Not recorded" %>
              </div>
            </section>
          <% end %>
        </div>

        <% if @situation.balanced_thought.present? %>
          <figure class="rounded-3xl bg-teal-50/70 p-6 ring-1 ring-teal-700/10 sm:p-8 dark:bg-white/5 dark:ring-white/10">
            <figcaption class="text-base/6 font-medium text-teal-800 sm:text-sm/6 dark:text-teal-300">A more balanced thought</figcaption>
            <blockquote class="mt-3 max-w-[60ch] font-display text-xl/8 text-pretty text-stone-800 italic dark:text-stone-100 [&_p+p]:mt-4">
              <%= simple_format(@situation.balanced_thought, {}, wrapper_tag: "p") %>
            </blockquote>
          </figure>
        <% end %>
      </article>

      <aside class="flex flex-col gap-6 lg:sticky lg:top-24 lg:col-span-4 lg:self-start">
        <dl class="flex flex-col divide-y divide-stone-950/5 rounded-3xl bg-stone-950/[0.025] px-6 py-2 ring-1 ring-stone-950/5 dark:divide-white/10 dark:bg-white/[0.03] dark:ring-white/10">
          <% [ [ "Where", @situation.location ], [ "Who was involved", @situation.who_was_involved ] ].each do |label, value| %>
            <div class="flex flex-col gap-1 py-4">
              <dt class="text-base/6 text-stone-500 sm:text-sm/6 dark:text-stone-400"><%= label %></dt>
              <dd class="text-base/6 font-medium text-stone-900 sm:text-sm/6 dark:text-white"><%= value.presence || "Not recorded" %></dd>
            </div>
          <% end %>

          <div class="flex flex-col gap-2 py-4">
            <dt class="text-base/6 text-stone-500 sm:text-sm/6 dark:text-stone-400">What you felt</dt>
            <dd>
              <% if @situation.emotions.any? %>
                <ul role="list" class="flex flex-wrap gap-1.5">
                  <% @situation.emotions.each do |emotion| %>
                    <li class="badge"><%= emotion %></li>
                  <% end %>
                </ul>
              <% else %>
                <p class="text-base/6 font-medium text-stone-900 sm:text-sm/6 dark:text-white">Not recorded</p>
              <% end %>
            </dd>
          </div>

          <div class="flex flex-col gap-2 py-4">
            <dt class="text-base/6 text-stone-500 sm:text-sm/6 dark:text-stone-400">How strongly you felt</dt>
            <dd class="flex flex-col gap-2">
              <% if @situation.emotion_level %>
                <%= render "shared/emotion_level", level: @situation.emotion_level %>
              <% else %>
                <p class="text-base/6 font-medium text-stone-900 sm:text-sm/6 dark:text-white">Not recorded</p>
              <% end %>
            </dd>
          </div>

          <% if @situation.emotion_level_after %>
            <div class="flex flex-col gap-2 py-4">
              <dt class="text-base/6 text-stone-500 sm:text-sm/6 dark:text-stone-400">After weighing it up</dt>
              <dd class="flex flex-col gap-2">
                <%= render "shared/emotion_level", level: @situation.emotion_level_after %>
                <% if (shift = feeling_shift(@situation)) %>
                  <p class="text-base/6 font-medium text-teal-800 sm:text-sm/6 dark:text-teal-300"><%= shift %></p>
                <% end %>
              </dd>
            </div>
          <% end %>

          <div class="flex flex-col gap-2 py-4">
            <dt class="text-base/6 text-stone-500 sm:text-sm/6 dark:text-stone-400">Distortions</dt>
            <dd>
              <% if @situation.distortions.any? %>
                <ul role="list" class="flex flex-wrap gap-1.5">
                  <% @situation.distortions.sort_by(&:title).each do |distortion| %>
                    <li><%= link_to distortion.title, distortion, class: "badge hover:bg-teal-100 dark:hover:bg-teal-400/20" %></li>
                  <% end %>
                </ul>
              <% else %>
                <p class="text-base/6 font-medium text-stone-900 sm:text-sm/6 dark:text-white">None selected</p>
              <% end %>
            </dd>
          </div>
        </dl>

        <div class="flex items-center gap-2">
          <%= link_to "Edit", edit_situation_path(@situation), class: "btn btn-secondary" %>
          <%= button_to "Delete", @situation, method: :delete, class: "btn btn-danger" %>
        </div>
      </aside>
    </div>
  </div>
</div>
