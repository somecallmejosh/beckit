<% content_for :title, @situation.display_title %>

<div class="page">
  <%# One reading column. The record runs as one story, in the order it was written: the moment, the thought and how it
      felt, the traps in it, the evidence, and the fairer thought with how it felt afterwards. A thread down the left
      ties the stages together, and the two ratings bookend it so before and after read as a pair. %>
  <div class="mx-auto flex max-w-3xl flex-col gap-10">
    <div class="flex items-center justify-between gap-4">
      <%= link_to situations_path, class: "btn-sm btn-ghost -ml-3" do %>
        <%= icon :arrow_left %> Journal
      <% end %>
      <div class="flex items-center gap-2">
        <%# An entry in progress picks up where it stopped; a finished one is edited from the first step. %>
        <% if (step = @situation.next_step) %>
          <%= link_to "Continue", situation_step_path(@situation, step), class: "btn-sm btn-primary" %>
        <% else %>
          <%= link_to "Edit", situation_step_path(@situation, Situation::STEPS.first), class: "btn-sm btn-secondary" %>
        <% end %>
        <%= button_to "Delete", @situation, method: :delete, class: "btn-sm btn-danger" %>
      </div>
    </div>

    <%= render "shared/flash" %>

    <%# The save that finished this entry sets one of these (SituationSteps#redirect_after_step). %>
    <% if (flash[:celebrate] || flash[:grown]) && @situation.balanced_thought.present? %>
      <%= render "reframed", situation: @situation %>
    <% end %>

    <header>
      <p class="text-base/6 font-medium text-teal-700 sm:text-sm/6 dark:text-teal-400">
        <time datetime="<%= @situation.date.iso8601 %>"><%= l @situation.date, format: :entry %></time>
      </p>
      <h1 class="mt-2 font-display text-4xl font-medium tracking-tight text-balance text-stone-900 dark:text-white"><%= @situation.display_title %></h1>
      <% context = [ [ "Where", @situation.location ], [ "With", @situation.who_was_involved ] ].select { it.last.present? } %>
      <% if context.any? %>
        <dl class="mt-4 flex flex-wrap gap-x-6 gap-y-1 text-base/6 sm:text-sm/6">
          <% context.each do |label, value| %>
            <div class="flex gap-1.5">
              <dt class="text-stone-500 dark:text-stone-400"><%= label %></dt>
              <dd class="font-medium text-stone-900 dark:text-white"><%= value %></dd>
            </div>
          <% end %>
        </dl>
      <% end %>
    </header>

    <% heading = "text-base/6 font-medium text-stone-900 sm:text-sm/6 dark:text-white" %>
    <% stage = "relative pl-10 not-last:pb-12 not-last:before:absolute not-last:before:top-8 not-last:before:bottom-2 not-last:before:left-[0.6875rem] not-last:before:w-px not-last:before:bg-stone-950/10 sm:pl-12 dark:not-last:before:bg-white/10" %>
    <% marker = "absolute top-0 left-0 flex size-6 items-center justify-center rounded-full" %>
    <% plain_marker = capture do %>
      <span aria-hidden="true" class="<%= marker %> bg-white ring-1 ring-stone-950/10 dark:bg-stone-950 dark:ring-white/15"><span class="size-1.5 rounded-full bg-stone-400 dark:bg-stone-500"></span></span>
    <% end %>

    <ol role="list" aria-label="The thought record">
      <li class="<%= stage %>">
        <%= plain_marker %>
        <section aria-labelledby="thought_heading">
          <h2 id="thought_heading" class="<%= heading %>">What went through your mind</h2>
          <% if @situation.thought_imagery.present? %>
            <div class="mt-3 max-w-[60ch] font-display text-xl/8 text-pretty text-stone-900 sm:text-2xl/9 dark:text-white [&_p+p]:mt-4">
              <%= simple_format(@situation.thought_imagery, {}, wrapper_tag: "p") %>
            </div>
          <% else %>
            <p class="mt-3 text-base/7"><%= not_recorded %></p>
          <% end %>

          <% if @situation.emotions.any? || @situation.emotion_level %>
            <div id="feeling_before" class="mt-6 flex flex-wrap items-end gap-x-10 gap-y-5">
              <% if @situation.emotions.any? %>
                <div class="flex flex-col gap-2">
                  <p class="text-base/6 text-stone-500 sm:text-sm/6 dark:text-stone-400">You felt</p>
                  <ul role="list" class="flex flex-wrap gap-1.5">
                    <% @situation.emotions.each do |emotion| %>
                      <li class="badge-neutral"><%= emotion %></li>
                    <% end %>
                  </ul>
                </div>
              <% end %>
              <% if @situation.emotion_level %>
                <dl class="w-40">
                  <%= render "feeling_level", label: "At the time", level: @situation.emotion_level %>
                </dl>
              <% end %>
            </div>
          <% end %>

          <% if @situation.action_in_moment.present? %>
            <div id="action_in_moment" class="mt-6 flex flex-col gap-2">
              <p class="text-base/6 text-stone-500 sm:text-sm/6 dark:text-stone-400">What you did</p>
              <div class="max-w-[60ch] text-base/7 text-pretty text-stone-700 dark:text-stone-300 [&_p+p]:mt-3">
                <%= simple_format(@situation.action_in_moment, {}, wrapper_tag: "p") %>
              </div>
            </div>
          <% end %>
        </section>
      </li>

      <li class="<%= stage %>">
        <%= plain_marker %>
        <section aria-labelledby="traps_heading">
          <h2 id="traps_heading" class="<%= heading %>">Thinking traps</h2>
          <% if @situation.distortions.any? %>
            <ul role="list" class="mt-3 flex flex-wrap gap-1.5">
              <% @situation.distortions.sort_by(&:title).each do |distortion| %>
                <li><%= link_to distortion.title, distortion, class: "badge hover:bg-teal-100 dark:hover:bg-teal-400/20" %></li>
              <% end %>
            </ul>
          <% else %>
            <p class="mt-2 text-base/7 sm:text-sm/6"><%= not_recorded %></p>
          <% end %>
        </section>
      </li>

      <li class="<%= stage %>">
        <%= plain_marker %>
        <section aria-labelledby="evidence_heading">
          <h2 id="evidence_heading" class="<%= heading %>">Weighing it up</h2>
          <%# One panel split in two, so for and against read as a pair. "Against" shares the balanced thought's teal,
              so the eye runs from it into the reframe below. %>
          <div class="mt-4 grid rounded-3xl panel max-md:divide-y md:grid-cols-2 md:divide-x divide-stone-950/5 dark:divide-white/10">
            <% [ [ "For the thought", @situation.evidence_for, "text-stone-500 dark:text-stone-400" ],
                 [ "Against it", @situation.evidence_against, "text-teal-700 dark:text-teal-400" ] ].each do |label, text, tone| %>
              <div class="flex flex-col gap-2 p-5 sm:p-6">
                <h3 class="text-base/6 font-medium sm:text-sm/6 <%= tone %>"><%= label %></h3>
                <div class="text-base/7 text-pretty text-stone-700 dark:text-stone-300 [&_p+p]:mt-3">
                  <%= text.present? ? simple_format(text, {}, wrapper_tag: "p") : not_recorded %>
                </div>
              </div>
            <% end %>
          </div>
        </section>
      </li>

      <% if @situation.balanced_thought.present? || @situation.emotion_level_after || @situation.action_next_time.present? %>
        <li class="<%= stage %>">
          <span aria-hidden="true" class="<%= marker %> bg-teal-600 text-white dark:bg-teal-500"><%= icon :check, "size-3.5" %></span>
          <section aria-labelledby="balanced_heading" class="rounded-3xl panel-teal p-6 sm:p-8">
            <h2 id="balanced_heading" class="text-base/6 font-medium text-teal-800 sm:text-sm/6 dark:text-teal-300">A more balanced thought</h2>
            <% if @situation.balanced_thought.present? %>
              <blockquote class="mt-3 max-w-[60ch] font-display text-xl/8 text-pretty text-stone-800 italic sm:text-2xl/9 dark:text-stone-100 [&_p+p]:mt-4">
                <%= simple_format(@situation.balanced_thought, {}, wrapper_tag: "p") %>
              </blockquote>
            <% else %>
              <p class="mt-3 text-base/7"><%= not_recorded %></p>
            <% end %>

            <% if @situation.emotion_level_after %>
              <div id="feeling_after" class="mt-6 flex flex-wrap items-end gap-x-10 gap-y-3 border-t border-teal-700/10 pt-5 dark:border-teal-400/20">
                <dl class="w-40">
                  <%= render "feeling_level", label: "Afterwards", level: @situation.emotion_level_after, accent: true %>
                </dl>
                <% if (shift = feeling_shift(@situation)) %>
                  <p id="feeling_shift" class="text-base/6 font-medium text-teal-800 sm:text-sm/6 dark:text-teal-300"><%= shift %></p>
                <% end %>
              </div>
            <% end %>

            <% if @situation.action_next_time.present? %>
              <div id="action_next_time" class="mt-6 flex flex-col gap-2 border-t border-teal-700/10 pt-5 dark:border-teal-400/20">
                <h3 class="text-base/6 font-medium text-teal-800 sm:text-sm/6 dark:text-teal-300">Next time</h3>
                <div class="max-w-[60ch] text-base/7 text-pretty text-stone-800 dark:text-stone-100 [&_p+p]:mt-3">
                  <%= simple_format(@situation.action_next_time, {}, wrapper_tag: "p") %>
                </div>
              </div>
            <% end %>
          </section>
        </li>
      <% end %>
    </ol>
  </div>
</div>
