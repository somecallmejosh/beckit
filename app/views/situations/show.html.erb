<% content_for :title, @situation.display_title %>

<div class="page">
  <div class="flex flex-col gap-6">
    <div class="flex items-center justify-between gap-4">
      <%= link_to situations_path, class: "btn-sm btn-ghost -ml-3" do %>
        <%= icon :arrow_left %> Journal
      <% end %>
      <div class="flex items-center gap-2">
        <%# An entry in progress picks up where it stopped; a finished one is edited from the first step. %>
        <% if (step = @situation.next_step) %>
          <%= link_to "Continue", situation_step_path(@situation, step), class: "btn-sm btn-primary" %>
        <% else %>
          <%= link_to "Edit", situation_step_path(@situation, Situation::STEPS.first), class: "btn-sm btn-secondary" %>
        <% end %>
        <%= button_to "Delete", @situation, method: :delete, class: "btn-sm btn-danger" %>
      </div>
    </div>

    <%= render "shared/flash" %>

    <%# Reads top to bottom as the thought record runs: what happened, the thought, the evidence, the balanced view. %>
    <%# The feeling card sits under the title on small screens and alongside the record from lg. %>
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-x-16">
      <header class="lg:col-span-8">
        <p class="text-base/6 font-medium text-teal-700 sm:text-sm/6 dark:text-teal-400">
          <time datetime="<%= @situation.date.iso8601 %>"><%= l @situation.date, format: :entry %></time>
        </p>
        <h1 class="mt-2 font-display text-4xl font-medium tracking-tight text-balance text-stone-900 dark:text-white"><%= @situation.display_title %></h1>
        <% context = [ [ "Where", @situation.location ], [ "With", @situation.who_was_involved ] ].select { it.last.present? } %>
        <% if context.any? %>
          <dl class="mt-4 flex flex-wrap gap-x-6 gap-y-1 text-base/6 sm:text-sm/6">
            <% context.each do |label, value| %>
              <div class="flex gap-1.5">
                <dt class="text-stone-500 dark:text-stone-400"><%= label %></dt>
                <dd class="font-medium text-stone-900 dark:text-white"><%= value %></dd>
              </div>
            <% end %>
          </dl>
        <% end %>
      </header>

      <aside class="lg:sticky lg:top-24 lg:col-span-4 lg:col-start-9 lg:row-span-2 lg:row-start-1 lg:self-start">
        <section aria-labelledby="feeling_heading" class="flex flex-col gap-5 panel p-6">
          <h2 id="feeling_heading" class="text-base/6 font-medium text-stone-900 sm:text-sm/6 dark:text-white">How you felt</h2>

          <% if @situation.emotions.any? %>
            <ul role="list" class="flex flex-wrap gap-1.5">
              <% @situation.emotions.each do |emotion| %>
                <li class="badge-neutral"><%= emotion %></li>
              <% end %>
            </ul>
          <% end %>

          <% if @situation.emotion_level %>
            <dl class="grid grid-cols-2 gap-6">
              <%= render "feeling_level", label: "At the time", level: @situation.emotion_level %>
              <% if @situation.emotion_level_after %>
                <%= render "feeling_level", label: "Afterwards", level: @situation.emotion_level_after, accent: true %>
              <% end %>
            </dl>
            <% if (shift = feeling_shift(@situation)) %>
              <p class="text-base/6 font-medium text-teal-800 sm:text-sm/6 dark:text-teal-300"><%= shift %></p>
            <% end %>
          <% end %>

          <% if @situation.emotions.none? && @situation.emotion_level.nil? %>
            <p class="text-base/6 sm:text-sm/6"><%= not_recorded %></p>
          <% end %>
        </section>
      </aside>

      <article class="flex min-w-0 flex-col gap-12 lg:col-span-8">
        <section aria-labelledby="thought_heading" class="flex flex-col gap-3">
          <h2 id="thought_heading" class="text-base/6 text-stone-500 sm:text-sm/6 dark:text-stone-400">What went through your mind</h2>
          <% if @situation.thought_imagery.present? %>
            <div class="max-w-[60ch] font-display text-xl/8 text-pretty text-stone-900 sm:text-2xl/9 dark:text-white [&_p+p]:mt-4">
              <%= simple_format(@situation.thought_imagery, {}, wrapper_tag: "p") %>
            </div>
          <% else %>
            <p class="text-base/7"><%= not_recorded %></p>
          <% end %>

          <% if @situation.distortions.any? %>
            <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-2">
              <h3 class="text-base/6 text-stone-500 sm:text-sm/6 dark:text-stone-400">Thinking traps</h3>
              <ul role="list" class="flex flex-wrap gap-1.5">
                <% @situation.distortions.sort_by(&:title).each do |distortion| %>
                  <li><%= link_to distortion.title, distortion, class: "badge hover:bg-teal-100 dark:hover:bg-teal-400/20" %></li>
                <% end %>
              </ul>
            </div>
          <% end %>
        </section>

        <%# "Against" shares the balanced thought's teal, so the eye runs from it into the reframe below. %>
        <div class="grid gap-8 md:grid-cols-2 md:gap-10">
          <% [ [ "Evidence for the thought", @situation.evidence_for, "border-stone-300 dark:border-white/20" ],
               [ "Evidence against it", @situation.evidence_against, "border-teal-600 dark:border-teal-400" ] ].each do |label, text, rule| %>
            <section class="flex flex-col gap-2 border-t-2 pt-4 <%= rule %>">
              <h2 class="text-base/6 font-medium text-stone-900 sm:text-sm/6 dark:text-white"><%= label %></h2>
              <div class="text-base/7 text-pretty text-stone-700 dark:text-stone-300 [&_p+p]:mt-3">
                <%= text.present? ? simple_format(text, {}, wrapper_tag: "p") : not_recorded %>
              </div>
            </section>
          <% end %>
        </div>

        <% if @situation.balanced_thought.present? %>
          <figure class="rounded-3xl panel-teal p-6 sm:p-8">
            <figcaption class="text-base/6 font-medium text-teal-800 sm:text-sm/6 dark:text-teal-300">A more balanced thought</figcaption>
            <blockquote class="mt-3 max-w-[60ch] font-display text-xl/8 text-pretty text-stone-800 italic sm:text-2xl/9 dark:text-stone-100 [&_p+p]:mt-4">
              <%= simple_format(@situation.balanced_thought, {}, wrapper_tag: "p") %>
            </blockquote>
          </figure>
        <% end %>
      </article>
    </div>
  </div>
</div>
