<%# locals: (form:, attribute:, legend:, hint:) %>
<% hint_id = "#{attribute}_hint" %>
<%# A 0-10 rating. Underneath it's a radio per level plus Skip; the rating controller swaps the numbered circles for a slider
    whose word and weather move as it's dragged, and keeps the radios in step, so the form and drafts don't change. %>
<%# The chosen option gets a check badge on its edge as well as the fill, so the choice doesn't rest on color alone. It sits
    outside the layout and lets clicks through to the radio beneath; on the wider Skip pill it moves in to meet the curve. %>
<% check_badge = ->(position) { tag.span icon(:check, "size-3.5"), aria: { hidden: true }, class: [ position, "pointer-events-none absolute -top-1.5 flex size-5 scale-50 items-center justify-center rounded-full bg-white text-teal-700 opacity-0 ring-1 ring-teal-700 group-has-checked:scale-100 group-has-checked:opacity-100 motion-safe:transition dark:bg-stone-950 dark:text-teal-400 dark:ring-teal-500" ] } %>
<fieldset id="situation_<%= attribute %>" aria-describedby="<%= hint_id %>" class="flex flex-col gap-4"
          data-controller="rating" data-rating-words-value="<%= SituationsHelper::RATING_WORDS.to_json %>">
  <legend id="<%= attribute %>_legend" class="question"><%= legend %></legend>
  <p id="<%= hint_id %>" class="mt-1 field-hint"><%= hint %></p>

  <div hidden data-rating-target="slider" class="flex max-w-md flex-col gap-3">
    <div aria-hidden="true" class="flex items-center gap-4">
      <%= render "situations/weather" %>
      <p class="flex items-baseline gap-2">
        <span data-rating-target="number" class="font-display text-3xl font-medium text-stone-900 tabular-nums dark:text-white"></span>
        <span data-rating-target="word" class="text-base/6 text-stone-600 sm:text-sm/6 dark:text-stone-400"></span>
      </p>
    </div>
    <%# Named by the legend and unnamed itself, so only the radio it moves is sent. %>
    <input type="range" min="0" max="10" step="1" aria-labelledby="<%= attribute %>_legend" aria-describedby="<%= hint_id %>"
           data-rating-target="range" data-action="input->rating#slide" class="rating-range">
    <div aria-hidden="true" class="flex justify-between text-sm/5 text-stone-500 tabular-nums dark:text-stone-400"><span>0</span><span>5</span><span>10</span></div>
  </div>

  <div class="flex flex-wrap items-start gap-2">
    <div data-rating-target="choices" class="grid grid-cols-6 gap-2 max-sm:w-full sm:flex sm:flex-wrap">
      <% (0..10).each do |level| %>
        <label class="group relative flex h-11 cursor-pointer items-center justify-center rounded-full text-base/6 font-medium text-stone-700 tabular-nums ring-1 ring-stone-950/10 hover:bg-stone-50 has-checked:bg-teal-700 has-checked:text-white has-checked:ring-teal-700 has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-teal-600 sm:size-10 sm:text-sm/6 dark:text-stone-300 dark:ring-white/10 dark:hover:bg-white/5 dark:has-checked:bg-teal-600 dark:has-checked:ring-teal-600">
          <%= form.radio_button attribute, level, class: "absolute inset-0 appearance-none rounded-full focus:outline-hidden" %>
          <%= level %>
          <%= check_badge.("-right-1.5") %>
        </label>
      <% end %>
    </div>
    <label class="group relative flex h-11 cursor-pointer items-center justify-center rounded-full px-4 text-base/6 font-medium text-stone-500 ring-1 ring-stone-950/10 hover:bg-stone-50 has-checked:bg-stone-950/5 has-checked:text-stone-900 has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-teal-600 sm:h-10 sm:text-sm/6 dark:text-stone-400 dark:ring-white/10 dark:hover:bg-white/5 dark:has-checked:bg-white/10 dark:has-checked:text-white">
      <%= form.radio_button attribute, "", checked: form.object.public_send(attribute).nil?, data: { rating_target: "skip", action: "rating#skipped" },
            class: "absolute inset-0 appearance-none rounded-full focus:outline-hidden" %>
      Skip
      <%= check_badge.("right-1") %>
    </label>
  </div>
</fieldset>
