<%# locals: (situation:, step:) %>
<%# One page of the entry form. The first step creates the entry. Moving on saves, which needs this page's one required answer;
    going back to an earlier step is a plain link (typed text stays in the tab's draft). %>
<% steps = Situation::STEPS %>
<% index = steps.index(step) %>
<% following = steps[index + 1] %>
<% content_for :title, step_title(step) %>

<div class="page">
  <div class="mx-auto flex max-w-2xl flex-col gap-8">
    <% if situation.persisted? %>
      <%= link_to situation, class: "btn-sm btn-ghost -ml-3 self-start" do %>
        <%= icon :arrow_left %> Back to entry
      <% end %>
    <% else %>
      <%= link_to situations_path, class: "btn-sm btn-ghost -ml-3 self-start" do %>
        <%= icon :arrow_left %> Journal
      <% end %>
    <% end %>

    <%# Drafts are keyed per user, entry and step, so a shared tab never shows someone else's text. %>
    <%= form_with model: situation, url: (situation.persisted? ? situation_step_path(situation, step) : situations_path), class: "flex flex-col gap-8",
          data: { controller: "draft", draft_key_value: [ "draft", Current.user.id, situation.id || "new", (step if situation.persisted?) ].compact.join(":"),
            action: "input->draft#save change->draft#save turbo:submit-end->draft#submitted" } do |form| %>
      <%# Enter submits with the form's first button, so this one (visually hidden, but rendered so every browser uses it) makes Enter mean Next (or Save on the last step). %>
      <%= button_tag "", name: (following && "go_to"), value: following, tabindex: -1, aria: { hidden: true }, class: "sr-only" %>

      <%# Steps open in order: earlier ones are links, this one and later ones are buttons that save first, up to the first step still
          waiting for its answer (or the next one, which saving this step reaches). Past that they wait. The bars fill up to the step showing. %>
      <nav aria-label="Entry steps">
        <ol role="list" class="grid grid-cols-4 gap-2 sm:gap-3">
          <% steps.each_with_index do |other, i| %>
            <li>
              <% item_class = "group flex w-full flex-col gap-2 rounded-xs pb-1 text-left text-sm/5" %>
              <% open_class = "cursor-pointer text-stone-500 hover:text-stone-800 aria-[current=step]:font-medium aria-[current=step]:text-teal-800 dark:text-stone-400 dark:hover:text-stone-200 dark:aria-[current=step]:text-teal-300" %>
              <% label = capture do %>
                <span aria-hidden="true" class="h-1 w-full rounded-full <%= i <= index ? "bg-teal-600 dark:bg-teal-400" : "bg-stone-950/10 dark:bg-white/10" %>"></span>
                <span class="text-pretty"><%= step_title(other) %></span>
              <% end %>
              <% if i < index %>
                <%= link_to label, situation_step_path(situation, other), class: [ item_class, open_class ] %>
              <% elsif i > index + 1 && !situation.reachable?(other) %>
                <%= tag.span label, aria: { disabled: true }, title: "Answer the earlier steps first", class: [ item_class, "text-stone-400 dark:text-stone-500" ] %>
              <% else %>
                <%= button_tag label, name: "go_to", value: other, aria: { current: ("step" if other == step) }, class: [ item_class, open_class ] %>
              <% end %>
            </li>
          <% end %>
        </ol>
      </nav>

      <div data-draft-target="notice" hidden role="status" class="flex flex-wrap items-center justify-between gap-3 rounded-2xl panel-teal px-4 py-3 text-base/6 text-teal-900 sm:text-sm/6 dark:text-teal-200">
        <p>We restored the text you hadn't saved yet.</p>
        <button type="button" class="btn-sm btn-ghost" data-action="draft#discard">Discard draft</button>
      </div>

      <%= render "shared/form_errors", record: situation %>

      <%# Named by its heading rather than a legend, which can't hold the intro and drawing. %>
      <fieldset aria-labelledby="step_heading" class="flex min-w-0 flex-col gap-8 motion-safe:transition motion-safe:duration-300 motion-safe:ease-out motion-safe:starting:translate-y-2 motion-safe:starting:opacity-0">
        <%# The drawing stands on the rule that closes the header, beside the heading and intro at every width. %>
        <div class="flex items-end gap-4 border-b border-stone-950/10 sm:gap-8 dark:border-white/10">
          <div class="min-w-0 flex-1 pb-6">
            <h1 id="step_heading" class="font-display text-3xl/tight font-medium tracking-tight text-balance text-stone-900 sm:text-4xl/tight dark:text-white"><%= step_title(step) %></h1>
            <p class="mt-3 text-lg/7 text-pretty text-stone-600 sm:text-base/7 dark:text-stone-400"><%= step_intro(step) %></p>
          </div>
          <%= step_image step, class: "size-28 shrink-0 sm:size-44" %>
        </div>
        <%= render "situations/steps/#{step.underscore}", form:, situation: %>
      </fieldset>

      <%# Save entry is on every step, so an entry can stop wherever it feels finished. %>
      <div class="flex items-center gap-3 border-t border-stone-950/5 pt-6 dark:border-white/10">
        <% if index > 0 %>
          <%= link_to situation_step_path(situation, steps[index - 1]), class: "btn-lg btn-ghost -ml-3" do %>
            <%= icon :arrow_left %> Back
          <% end %>
        <% end %>
        <div class="ml-auto flex items-center gap-2">
          <% if following %>
            <%= button_tag "Save entry", class: "btn-lg btn-ghost" %>
            <%= button_tag "Next", name: "go_to", value: following, class: "btn-lg btn-primary min-w-24" %>
          <% else %>
            <%= button_tag "Save entry", class: "btn-lg btn-primary" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
