<%# locals: (label:, level:, accent: false) %>
<%# One 0-10 rating as a large number over a full-width meter, so before and after compare at a glance. %>
<div class="flex flex-col gap-2">
  <dt class="text-base/6 text-stone-500 sm:text-sm/6 dark:text-stone-400"><%= label %></dt>
  <dd class="flex flex-col gap-2.5">
    <p class="font-display text-4xl/none font-medium tabular-nums <%= accent ? "text-teal-800 dark:text-teal-300" : "text-stone-900 dark:text-white" %>">
      <%= level %><span class="text-base/6 font-normal text-stone-500 dark:text-stone-400">/10</span>
    </p>
    <div class="flex gap-0.5" aria-hidden="true">
      <% 10.times do |i| %>
        <span class="h-1.5 flex-1 rounded-full <%= i < level ? (accent ? "bg-teal-600 dark:bg-teal-400" : "bg-stone-500 dark:bg-stone-400") : "bg-stone-950/10 dark:bg-white/10" %>"></span>
      <% end %>
    </div>
  </dd>
</div>
