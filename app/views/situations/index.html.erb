<% content_for :title, [ @distortion ? "#{@distortion.title} entries" : "Journal", ("page #{@page}" if @page > 1) ].compact.join(", ") %>

<div class="page">
  <div class="grid gap-10 lg:grid-cols-[18rem_minmax(0,1fr)] lg:gap-16">
    <aside class="flex flex-col gap-8 lg:sticky lg:top-24 lg:self-start">
      <div class="flex flex-col gap-6">
        <div>
          <%= greeting_image class: "mb-6 aspect-[3/2] w-full max-w-sm rounded-3xl object-cover ring-1 ring-stone-950/5 lg:max-w-none dark:ring-white/10 bg-stone-50" %>
          <h1 class="font-display text-2xl font-medium tracking-tight text-balance text-stone-900 dark:text-white"><%= greeting_for(Current.user) %></h1>
          <p class="mt-3 max-w-[48ch] text-lg/7 text-pretty text-stone-600 dark:text-stone-400">
            <%= Current.user.birthday_today? ? "Be kind to yourself today." : "Notice the thought, weigh the evidence, and find a kinder way of seeing things." %>
          </p>
        </div>
      </div>

      <% unless @summary.empty? %>
        <%# On small screens the summary moves below the entries (see the end of this page). %>
        <%= render "summary", summary: @summary, css: "max-lg:hidden" %>
      <% end %>
    </aside>

    <div class="flex min-w-0 flex-col gap-8">
      <%= render "shared/flash" %>

      <% if @any_entries %>
        <% filters = { q: @query.presence, distortion_id: @distortion&.id, insights_range: @insights_range }.compact %>
        <%# A filtered journal says so up top, and links back to Insights when that's where the filter came from. %>
        <% if @match_count %>
          <section aria-labelledby="filter_heading" class="flex flex-col gap-4 rounded-3xl panel-teal p-6">
            <% if @insights_range %>
              <%= link_to insights_path(distortion_id: @distortion.id, range: @insights_range), class: "btn-sm btn-ghost -ml-3 -mt-2 self-start" do %>
                <%= icon :arrow_left %> <%= @distortion.title %> insights
              <% end %>
            <% end %>
            <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
              <div class="min-w-0">
                <h2 id="filter_heading" class="font-display text-2xl font-medium tracking-tight text-balance text-stone-900 dark:text-white"><%= @distortion ? @distortion.title : "Search results" %></h2>
                <p role="status" class="mt-1 text-base/6 text-pretty text-stone-600 sm:text-sm/6 dark:text-stone-300"><%= filter_summary @match_count, distortion: @distortion, query: @query %></p>
              </div>
              <%= link_to "Show all entries", situations_path, class: "btn-sm btn-secondary self-start sm:self-auto" %>
            </div>
          </section>
        <% end %>

        <%# One toolbar: the two buttons share a size and a row, and the search panel opens beneath them at the
            list's full width. The toggle sits in the row's corner (absolute), so opening it doesn't move "New entry". %>
        <div id="entries" class="relative scroll-mt-24">
          <%= link_to new_situation_path, class: "btn btn-primary" do %><%= icon :plus %> New entry<% end %>

          <%# Search is occasional, so it stays folded away until asked for, or while a search or filter is showing. %>
          <details class="group/search" <%= "open" if @match_count %>>
            <summary class="btn btn-secondary absolute top-0 right-0 list-none [&::-webkit-details-marker]:hidden group-open/search:bg-stone-50 dark:group-open/search:bg-white/10">
              <span class="group-open/search:hidden contents"><%= icon :magnifying_glass %> Search entries</span>
              <span class="group-not-open/search:hidden contents"><%= icon :x_mark %> Hide search</span>
            </summary>
            <%= form_with url: situations_path, method: :get, html: { role: "search" }, class: "mt-4 grid grid-cols-[minmax(0,1fr)_auto] items-end gap-3 panel p-4 motion-safe:animate-reveal sm:grid-cols-[minmax(0,1fr)_14rem_auto] sm:p-5" do |form| %>
              <div class="col-span-2 flex flex-col gap-2 sm:col-span-1">
                <%= form.label :q, "Words to find", class: "field-label" %>
                <div class="relative">
                  <%= icon :magnifying_glass, "pointer-events-none absolute top-1/2 left-3.5 -translate-y-1/2 text-stone-400" %>
                  <%= form.search_field :q, value: @query, class: "field pl-9" %>
                </div>
              </div>
              <div class="flex min-w-0 flex-col gap-2">
                <%= form.label :distortion_id, "Thinking trap", class: "field-label" %>
                <%= form.select :distortion_id, options_from_collection_for_select(Distortion.order(:title), :id, :title, @distortion&.id),
                      { include_blank: "Any" }, class: "field" %>
              </div>
              <%= form.submit "Search", name: nil, class: "btn btn-secondary py-3 sm:py-2.5" %>
            <% end %>
          </details>
        </div>

        <%# Past the first page the list looks just like the first, so say where in the journal this is. %>
        <% if @page > 1 && @situations.any? %>
          <div id="page_status" class="flex flex-col gap-3 rounded-2xl panel px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
            <p role="status" class="flex flex-col text-base/6 text-pretty text-stone-600 sm:text-sm/6 dark:text-stone-400">
              <span class="font-medium text-stone-900 dark:text-white">Page <%= @page %> of <%= @page_count %></span>
              <span>Entries from <span class="whitespace-nowrap"><%= l @situations.first.date, format: :entry_date %></span> back to <span class="whitespace-nowrap"><%= l @situations.last.date, format: :entry_date %></span></span>
            </p>
            <%= link_to situations_path(filters.merge(anchor: "entries")), class: "btn-sm btn-ghost -mx-3 self-start sm:mx-0 sm:self-auto" do %><%= icon :arrow_left %> Newest entries<% end %>
          </div>
        <% end %>

        <div id="situations" class="flex flex-col gap-14">
          <% @situations.group_by { it.date.beginning_of_month }.each do |month, situations| %>
            <section aria-labelledby="month_<%= month.strftime("%Y_%m") %>">
              <h2 id="month_<%= month.strftime("%Y_%m") %>" class="mb-5 font-display text-lg/7 font-medium text-stone-900 dark:text-white"><%= l month, format: "%B %Y" %><% if month == @continued_month %><span class="font-normal text-stone-400 dark:text-stone-500">, continued</span><% end %></h2>
              <ul role="list" class="flex flex-col gap-4">
                <%= render situations %>
              </ul>
            </section>
          <% end %>
        </div>

        <% if @situations.empty? %>
          <p class="rounded-3xl border border-dashed border-stone-950/10 px-6 py-14 text-center text-base/7 text-pretty text-stone-600 sm:text-sm/6 dark:border-white/10 dark:text-stone-400">No entries match. Try other words, or a different thinking trap.</p>
        <% end %>

        <% if @page > 1 || @older_page %>
          <%# Page links land on the list, not the page top: on a phone the greeting would otherwise fill the screen. %>
          <nav aria-label="Pages" class="grid grid-cols-[1fr_auto_1fr] items-center gap-4 border-t border-stone-950/5 pt-6 dark:border-white/10">
            <% if @page > 1 %>
              <%= link_to situations_path(filters.merge(page: (@page - 1 if @page > 2), anchor: "entries").compact), class: "btn btn-secondary justify-self-start" do %><%= icon :arrow_left %> <span><span class="max-sm:hidden">Newer entries</span><span class="sm:hidden">Newer</span></span><% end %>
            <% else %>
              <span></span>
            <% end %>
            <p class="text-base/6 text-stone-500 tabular-nums sm:text-sm/6 dark:text-stone-400">Page <%= @page %> of <%= @page_count %></p>
            <% if @older_page %>
              <%= link_to situations_path(filters.merge(page: @page + 1, anchor: "entries")), class: "btn btn-secondary justify-self-end" do %><span class="max-sm:hidden">Older entries</span><span class="sm:hidden">Older</span><% end %>
            <% end %>
          </nav>
        <% end %>
      <% else %>
        <%= render "intro", user: Current.user %>
      <% end %>

      <% unless @summary.empty? %>
        <%= render "summary", summary: @summary, id: "summary_mobile", css: "lg:hidden" %>
      <% end %>
    </div>
  </div>
</div>
