<% content_for :title, "Journal" %>

<div class="page">
  <div class="grid gap-10 lg:grid-cols-[18rem_minmax(0,1fr)] lg:gap-16">
    <aside class="flex flex-col gap-8 lg:sticky lg:top-24 lg:self-start">
      <div class="flex flex-col gap-6">
        <div>
          <h1 class="font-display text-4xl font-medium tracking-tight text-balance text-stone-900 dark:text-white"><%= greeting_for(Current.user) %></h1>
          <p class="mt-3 max-w-[48ch] text-lg/7 text-pretty text-stone-600 dark:text-stone-400">
            <%= Current.user.birthday_today? ? "Be kind to yourself today." : "Notice the thought, weigh the evidence, and find a kinder way of seeing things." %>
          </p>
        </div>
        <%= link_to "New entry", new_situation_path, class: "btn btn-primary self-start" %>
      </div>

      <% unless @summary.empty? %>
        <%= render "summary", summary: @summary %>
      <% end %>
    </aside>

    <div class="flex min-w-0 flex-col gap-8">
      <%= render "shared/flash" %>

      <% if @situations.any? %>
        <ul id="situations" role="list" class="divide-y divide-stone-950/5 dark:divide-white/10 max-lg:border-t max-lg:border-stone-950/5 max-lg:dark:border-white/10">
          <%= render @situations %>
        </ul>
      <% else %>
        <div class="rounded-3xl border border-dashed border-stone-950/10 px-6 py-14 text-center dark:border-white/10">
          <h2 class="font-display text-xl font-medium text-balance text-stone-900 dark:text-white">A quiet place to begin</h2>
          <p class="mx-auto mt-2 max-w-[48ch] text-base/7 text-pretty text-stone-600 sm:text-sm/6 dark:text-stone-400">When a moment feels heavy, write down what happened and what went through your mind. You can work through it at your own pace.</p>
          <div class="mt-6">
            <%= link_to "Write your first entry", new_situation_path, class: "btn btn-secondary" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
